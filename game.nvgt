string menu2(enhanced_menu@ lmenu, string data) {
if (key_pressed(KEY_NEXT)) music.volume=music.volume-3;
if (key_pressed(KEY_PRIOR)) music.volume=music.volume+3;
return "";
}
string checkmenu(enhanced_menu@ lmenu, string data) {
if (key_pressed(KEY_NEXT)) music.volume=music.volume-3;
if (key_pressed(KEY_PRIOR)) music.volume=music.volume+3;
if (creatingpack) return "";
string lev;
if (lmenu.currentItem()!=mp) {
mp=lmenu.currentItem();
if (mp!="esc") {
if (is_in_array(mp,lockedlevels)) {
if (lang==1) rd.say("locked");
if (lang==2) rd.say("bloqueado");
}
else {
lev=string_trim_right(mp,4);
int value=string_to_number(get_level(lev));
switch(value) {
case 0:
if (lang==1) rd.say("You haven't played this level before.");
if (lang==2) rd.say("No has jugado este nivel");
newlevel.stop();
newlevel.play();
break;
case 1:
if (lang==1) rd.say("You played this level and failed.");
if (lang==2) rd.say("has fallado este nivel");
faillevel.stop();
faillevel.play();
break;
case 2:
if (lang==1) rd.say("ok");
if (lang==2) rd.say("bien");
oklevel.stop();
oklevel.play();
break;
case 3:
if (lang==1) rd.say("super");
if (lang==2) rd.say("súper");
superlevel.stop();
superlevel.play();
break;
case 4:
if (lang==1) rd.say("perfect!");
if (lang==2) rd.say("perfecto!");
perfectlevel.stop();
perfectlevel.play();
break;
}
}
}
}
return "";
}
void main() {
string[] cml=string_split(com,"\\",true);
if (cml.length()>0) com=cml[cml.length()-1];
else com="";
if (lang==1)
{
show_game_window("Rhythm Rage ");
}
if (lang==2)
{
show_game_window("beatstar plus ");
}
perfectjng="perfect_jingle";
super="super_jingle";
failjng="fail_jingle";
okjng="ok_jingle";
nopack();
installed=file_exists("z.iss");
if (installed) path=DIRECTORY_APPDATA+"/Oriol Gomez/";
directory_create(path);
if (installed) path=DIRECTORY_APPDATA+"/Oriol Gomez/rg/";
directory_create(path+"packs");
directory_create(DIRECTORY_APPDATA+"/Oriol Gomez/rg/saves");
if (screen_reader_is_running(1)) install_keyhook();
sl="speaker_"+lang+"_";
vo.prepend=sl+"num_";
if (lang==2) vo.include_and=true;
vo.append="";
set_sound_storage(path+"sounds"+lang+".pack");
lockerror.load("lock_error");
oklevel.load("oklevel");
faillevel.load("faillevel");
newlevel.load("newlevel");
newlevel.volume=-2;
superlevel.load("superlevel");
perfectlevel.load("perfectlevel");
if (!SCRIPT_COMPILED && com=="") {
generate_soundpack();
}
generate_packs();
deser();
if (com=="") playintro("logo"+lang,false);
yespack();
package.open(path+"packs/"+pack+".pack");
start();
}
void generate_soundpack() {
		string[] files=find_files("sounds/*");
	if (files.length()==0) {
				}
	else {
package.create(path+"sounds"+lang+".pack");
		for(uint counter=0; counter<files.length(); counter++)
		{
			if (string_contains(files[counter],"speaker_",1)!=-1) {
				string[] speakers=string_split(files[counter],"_",true);
if (speakers[1]==lang) {
						package.add_file("sounds/"+files[counter],string_left(files[counter], files[counter].length()-4));
}
else {
}
}
else {
package.add_file("sounds/"+files[counter],string_left(files[counter], files[counter].length()-4));
}
}
}
}
void generate_packs() {
pack_file package;
string[] packs=find_directories(path+"packs/*");
if (packs.length()>1) {
if (lang==1) alert("Multiple packs","There are multiple folders inside the packs folder. You can only work on one pack at a time.");
if (lang==2) alert("paquetes múltiples", "solo se puede trabajar con un paquete a la vez. Tienes más de una carpeta en la carpeta packs.");
return;
}
if (packs.length()==0) {
return;
}
pack=packs[0];
package.create(path+"packs/"+packs[0]+".pack");
creatingpack=true;
string[] files=find_files(path+"packs/"+packs[0]+"/*");
if (files.length()==0) {
if (lang==1) alert("error","error packing the files in your new pack.");
if (lang==2) alert("error","Hay un error con los archivos de tu nuevo paquete de sonidos.");
creatingpack=false;
exit();
}
else {
for(uint counter=0; counter<files.length(); counter++)
{
if (string_contains(files[counter],".ogg",1)!=-1) {
bool encr=file_encrypt(path+"packs/"+packs[0]+"/"+files[counter],"encdata",packs[0]+"guillemandoriolftw");
if (!encr) {
alert("encrypt error","error!"+files[counter]);
pack="default";
exit();
return;
}//encr failed
bool adding=package.add_file("encdata",string_left(files[counter], files[counter].length()-4));
if (!adding) {
alert("error",files[counter]);
exit();
}//adding
}//ogg
else {
bool adding=package.add_file(path+"packs/"+packs[0]+"/"+files[counter],files[counter]);
if (!adding) {
alert("error",files[counter]);
exit();
}
}
}
}
file_delete("encdata");
}
void start() {
if (com!="" and creatingpack) {
startlev(com);
}
if (com!="" and !creatingpack) {
if (lang==1) alert("error","You can only run levels from the command line if you are creating a pack!");
if (lang==2) alert("vaya","solo puedes ejecutar niveles desde la línea de comandos si estás creando un pack.");
}
yespack();
ser();
mp=-1;
vos.stop();
pool.destroy_all();
music.stop();
if (debugl!="") {
nopack();
tut_ap.load("tut_good");
tut_early.load("tut_early");
tut_late.load("tut_late");
tut_great.load("tut_bell");
tut_beep.load("tut_beep");
yespack();
tutorial=true;
startlev(debugl);
}
enhanced_menu menu;
menu.set_callback(menu2,"");

select.load("menu_select");
music.stop();
music.stream("menu_music");
music.volume=-10;
music.play_looped();
menu.move_path="menu_move";
menu.set_speech_mode(rd.reader_mode);
menu.ats("level select","jugar nivel","s");
unlocksa=string_split(unlocks,",",true);
packnames=find_files(path+"packs/*");
string[] temp;
for (uint i=0;i<packnames.length();i++) {
if (is_in_array(packnames[i],unlocksa)) {
temp.insert_last(packnames[i]);
}
else {
}
}
unlocksa=temp;
checkpack();
unlocksa=temp;
if (unlocksa.length()!=1) {
menu.ats("change pack","cambiar paquete","change");
}
menu.ats("store current credits "+cash,"tienda créditos ahora "+cash,"store");
menu.ats("download new packs","descargar nuevos packs","getpacks");
menu.ats("keyboard delay settings for virtual machines (current delay is "+keycal+"ms)","configurar retraso del teclado para máquinas virtuales (retraso actual es de "+keycal+"ms)","calkey");
menu.ats("achievements,","logros","ach");
menu.ats("delete all achievements,","borrar todos tus logros","achclear");
menu.ats("exit","salir","esc");
string o;
if (lang==2) o=menu.run_extended("Bienvenido! Usa las flechas para seleccionar una opción y pulsa énter. Usa las teclas avanzar y retroceder página para cambiar el volumen de la música",true,"esc",true);
if (lang==1) o=menu.run_extended("Welcome! Use the up and down arrow keys to choose an option, and enter to select it. You can use page up and page down to change the volume of the background music.",true,"esc",true);
yespack();
if (o=="ach") {
select.play();
fade(music);
achprizes();
}
if (o=="achclear") {
select.play();
fade(music);
achclear();
}

if (o=="store") {
select.play();
fade(music);
store();
}
if (o=="getpacks") {
select.play();
fade(music);
getpacks();
}

if (o=="calkey") {
select.play();
fade(music);
calibrate_keyboard();
}

if (o=="change") {
select.play();
fade(music);
packchange();
}
if (o=="esc") {
select.play();
fade(music);
int donation=random(1,7);
if (donation==7 and SCRIPT_COMPILED) {
if (lang==1) alert("Hello!","If you enjoy this game, please do consider making a donation at http://www.oriolgomez.com and/or subscribing to our mailing list at: oriolgomez+subscribe@groups.io. Your contributions and/or encouragement messages are greatly appreciated! As a donator, you will receive the rhythm rage extra content package which includes the perfect versions for all songs and the original music without sounds.");
if (lang==2) alert("hola!","Si te gusta este juego, por favor considera hacer una pequeña donación a http://www.oriolgomez.com y/o suscríbete a nuestra lista de correo, radiolavila+subscribe@groups.io. Tus contribuciones y/o mensajes de apoyo son de mucho agrado! Si haces una donación, recibirás como extra el paquete de contenidos extra que incluye todas las versiones de las músicas del juego en perfecto así como la música original.");
}
exit();
return;
}
if (o=="s") {
select.play();
fade(music);
startgame(1);
return;
}
}
void startgame(int md) {
perfectrun=false;
musiconly=false;
question_state=2;
if (md==1) {
music.stream("select_level_music");
music.volume=-12;
music.play_looped();
}
flist=package.list_files();
string[] levfiles;
last=false;
okval=0;
for (uint i=0;i<flist.length();i++) {
if (string_right(flist[i],4)==".lvl") levfiles.insert_last(flist[i]);
}
levfiles.sort_ascending();
enhanced_menu lmenu;
lmenu.move_path="menu_move";
lmenu.set_callback(checkmenu, "");
lmenu.set_speech_mode(rd.reader_mode);
int levels=0,locked=0;
lockedlevels.resize(0);
string levname;
string lock;
if (lang==1) lock="locked";
if (lang==2) lock="bloqueado";
for (uint i=0;i<levfiles.length();i++) {
levname=string_trim_right(levfiles[i],4);
//lockcheck
if (get_level(levname)>1 or i==0 or creatingpack) {
levels++;
lmenu.ats(get_line(levfiles[i],0),get_line(levfiles[i],0),levfiles[i]);
}
else {
if (get_level(string_trim_right(levfiles[i-1],4))>1) {
levels++;
lmenu.ats(get_line(levfiles[i],0),get_line(levfiles[i],0),levfiles[i]);
continue;
}
lmenu.ats(get_line(levfiles[i],0),get_line(levfiles[i],0),levfiles[i]);
lockedlevels.insert_last(levfiles[i]);
locked++;
}
}
lmenu.ats("go back","volver","esc");
if (lang==1) lock="You must unlock the previous levels to proceed.";
if (lang==2) lock="Debes desbloquear los niveles anteriores para proceder.";
string o;
if (lang==1) o=lmenu.run_extended("Level select menu: "+levels+" available levels. "+locked+" are locked.",true,"esc",true);
if (lang==2) o=lmenu.run_extended("Selecciona un nivel: "+levels+" niveles disponibles, y "+locked+" están bloqueados.",true,"esc",true);
while (is_in_array(o,lockedlevels)) {
lockerror.stop();
lockerror.play();
o=lmenu.run_extended(lock,true,"esc",false);
wait(5);
}
if (o=="esc") {
select.play();
//fade(music);
start();
return;
}
else {
if (levfiles[levfiles.length()-1]==o) last=true;
startlev(o);
}
}
void ser() {
if (creatingpack) {
return;
}
//if (!SCRIPT_COMPILED) return;
dictionary data;
data.set("cash",cash);
data.set("unlocks",unlocks);
data.set("pack",pack);
//save unlocks here
string[] save=unlockinfo.get_keys();
string savea;
for (uint i=0;i<save.length();i++) {
ok=unlockinfo.get(save[i],savea);
if (!ok) {
if (lang==1) 
alert("error","error saving unlocked level information.");
if (lang==2) 
alert("error","Hubo un error al guardar tu información sobre paquetes desbloqueados. Puede que encuentres algún problema.");
break;
}
data.set("u."+save[i],savea);
for (uint u=0;u<savea.length();u++) {
}
}
data.set("achievements",achievements);
string srld=serialize(data);
string esrld=string_encrypt(srld,"soyelputoamo");
file fld;
fld.open(DIRECTORY_APPDATA+"/Oriol Gomez/rg/saves/rg.dat","wb");
fld.write(esrld);
fld.close();
}
void deser() {
cash=0;
unlocks="default.pack,";
if(file_exists(DIRECTORY_APPDATA+"/Oriol Gomez/rg/saves/rg.dat")) {
file fld;
fld.open(DIRECTORY_APPDATA+"/Oriol Gomez/rg/saves/rg.dat","rb");
string dsr=fld.read();
dsr=string_decrypt(dsr,"soyelputoamo");
dictionary data=deserialize(dsr);
string[] datas=data.get_keys();
for (uint i=0;i<datas.length();i++) {
}
for (uint i=0;i<data.get_keys().length();i++) {
}
if (data.exists("achievements")) 
data.get("achievements",achievements);
if (data.exists("cash"))
data.get("cash",cash);
if (data.exists("unlocks")) 
data.get("unlocks",unlocks);
if (unlocks=="") unlocks+="default.pack,";
string[] levels=string_split(unlocks,".pack,",true);
int curl;
for (uint i=0;i<levels.length();i++) {
curl=i;
string result;
ok=data.get("u."+levels[i]+".pack",result);
if (ok) {
string[] lvl=string_split(result,",,,",true);
for (uint i=0;i<lvl.length();i++) {
string[] lvln=string_split(lvl[i],"===",true);
set_level(lvln[0],lvln[1],levels[curl]);
}
}
}
}
else {
ser();
}
}
void store() {
nopack();
if (!debug && cash<1000) {
if (lang==1) rd.add("You don't have enough credits to buy a new pack... You only have "+cash+" and you need at least 1000!",false,true);
if (lang==2) rd.add("No tienes suficientes créditos para comprar un nuevo paquete, necesitas al menos 1000 y tienes "+cash,false,true);
start();
return;
}
if (lang==1) rd.say("Use the up and down arrow keys to choose a pack, and enter to select it.");
if (lang==2) rd.say("Usa las flechas arriba y abajo para escoger un paquete y énter para seleccionarlo.");
packnames.resize(0);
packfiles.resize(0);
packing=true;
packfiles=find_files(path+"packs/*.pack");
unlocksa=string_split(unlocks,",",true);
for (uint i=0;i<packfiles.length();i++) {
if (!is_in_array(packfiles[i],unlocksa)) {
packnames.insert_at(0,packfiles[i]);
}
}
if (packnames.length()==0) {
if (lang==1) rd.add("You've bought all the available packs.",false,true);
if (lang==2) rd.add("Ya has comprado todos los packs.",false,true);
start();
return;
}
else {
mpos=-1;
while (packing) {
packloop();
}//loop
}//if packnames 0
}//function
void packchange() {
nopack();
if (lang==1) rd.say("Use the up and down arrow keys to choose a pack, and enter to select it.");
if (lang==2) rd.say("Usa las flechas arriba y abajo para escoger un paquete y énter para seleccionarlo.");
packing=true;
unlocksa=string_split(unlocks,",",true);
packnames=find_files(path+"packs/*");
string[] temp;
for (uint i=0;i<packnames.length();i++) {
if (is_in_array(packnames[i],unlocksa)) {
temp.insert_last(packnames[i]);
}
else {
}
}
unlocksa=temp;
mpos=-1;
if (temp.length()==0) {
if (lang==1) rd.add("There aren't any packs to change to! Press enter.",false,true);
if (lang==2) rd.add("No hay packs para cambiar!",false,true);
start();
return;
}
while (packing) {
packloop2();
}//loop
}//function
void packloop() {
if(key_pressed(KEY_ESCAPE)) {
pool.destroy_all();
music.stop();
packer.stop();
packing=false;
start();
return;
}
if (key_down(KEY_M)) {
rd.say(cash);
}
if(key_pressed(KEY_DOWN)) {
mpos+=1;
if(mpos>=packnames.length()) {
mpos=0;
}
packer.stop();
set_sound_storage(path+"packs/"+packnames[mpos]);
rd.say(packnames[mpos]);
string key=string_replace(packnames[mpos],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}
if(key_pressed(KEY_UP)) {
mpos-=1;
if(mpos<0) {
mpos=packnames.length()-1;
}
packer.stop();
set_sound_storage(path+"packs/"+packnames[mpos]);
rd.say(packnames[mpos]);
string key=string_replace(packnames[mpos],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}
if(key_pressed(KEY_RETURN)) {
if (mpos>=0) {
unlocks=unlocks+packnames[mpos]+",";
if (!debug) lesscash(1000);
packer.stop();
packer.stream("buypack");
packer.play_wait();
pack=string_trim_right(packnames[mpos],5);
load_pack();
creatingpack=false;
ser();
start();
return;
}
wait(5);
}
wait(5);
}
void packloop2() {
if(key_pressed(KEY_ESCAPE)) {
packer.stop();
packing=false;
start();
return;
}
if (key_pressed(KEY_M)) {
nopack();
vo.speak(cash);
while (vo.speak_next()==1) {
packloop2();
wait(5);
}
}
if(key_pressed(KEY_DOWN)) {
mpos+=1;
if(mpos>=unlocksa.length()) {
mpos=0;
}
packer.stop();
set_sound_storage(path+"packs/"+unlocksa[mpos]);
rd.say(unlocksa[mpos]);
string key=string_replace(unlocksa[mpos],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}

if(key_pressed(KEY_UP)) {
mpos-=1;
if(mpos<0) {
mpos=unlocksa.length()-1;
}
packer.stop();
set_sound_storage(path+"packs/"+unlocksa[mpos]);
rd.say(unlocksa[mpos]);
string key=string_replace(unlocksa[mpos],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}
if(key_pressed(KEY_RETURN)) {
if (mpos>=0) {
packer.stop();
packing=false;
pack=string_trim_right(unlocksa[mpos],5);
load_pack();
creatingpack=false;
ser();
start();
return;
}
}
wait(5);
}
void load_pack() {
yespack();
alreadyplayed=false;
}
void checkpack() {
bool played;
if (music.playing) {
music.stop();
played=true;
}
bool suc=package.open(path+"packs/"+pack+".pack");
if (!suc) {
alert("error","pack error!");
exit();
}
if (package.file_exists("tut_next")) {
yespack();
tuten.load("tut_next");
}
else {
nopack();
tuten.load("tut_next");
yespack();
}
if (package.file_exists("tut_start")) {
yespack();
tutes.load("tut_start");
}
else {
nopack();
tutes.load("tut_start");
yespack();
}
if (package.file_exists("tut_end")) {
yespack();
tute.load("tut_end");
}
else {
nopack();
tute.load("tut_end");
yespack();
}
nopack();
//change
tut_ap.load("tut_good");
tut_early.load("tut_early");
tut_late.load("tut_late");
tut_great.load("tut_bell");
tut_beep.load("tut_beep");
yespack();
string stre;
if (lang==1) stre=" not found in pack.";
if (lang==2) stre=" no encontrado en el pack.";
if (!package.file_exists(perfectjng)) {
alert("error",perfectjng+stre);
exit();
}
if (!package.file_exists(super)) {
alert("error",super+stre);
exit();
}
if (!package.file_exists(okjng)) {
alert("error",okjng+stre);
exit();
}
if (!package.file_exists(failjng)) {
alert("error",failjng+stre);
exit();
}
if (!package.file_exists("win_pack") and creatingpack) {
if (lang==1) alert("warning","there is no win_pack sound for beating the last level!");
if (lang==2) alert("atención","no hay un archivo win_pack para reproducir cuando se gana el último nivel!");
}

if (package.file_exists("logo") && SCRIPT_COMPILED and !alreadyplayed) {
alreadyplayed=true;
music.pause();
playintro("logo",false);
music.play_looped();
}
else {
}
if (!package.file_exists("newach") and creatingpack) {
if (lang==1) alert("Warning!","This pack doesn't have a newach.ogg file, which is played when you get an achievement. You can ignore this, but this nag screen will appear until you put one. So even if you don't use achievements, I would do it.");
if (lang==2) alert("Atención!","este pack no tiene el archivo newach.ogg, que se usa cuando consigues un nuevo logro. Puedes ignorar este mensaje, pero aparecerá cada vez que abras el juego hasta que pongas uno.");
}
if (!package.file_exists("win_pack") and creatingpack) {
if (lang==1) alert("Warning!","This pack doesn't have a win_pack.ogg file, which is played when you win all levels in the pack. You can ignore this, but this nag screen will appear until you put one. So even if you don't use achievements, I would do it.");
if (lang==2) alert("Atención!","este pack no tiene el archivo win_pack.ogg, que se usa cuando ganas todos los niveles. Puedes ignorar este mensaje, pero aparecerá cada vez que abras el juego hasta que pongas uno.");
}

if (package.file_exists("newach")) {
achs.load("newach");
}
if (played) music.play_looped();
}
void loadlev(string name,int volume) {
perfect=true;
if (tutorial) {
tutorial=false;
tute.play();
startlev(olv);
return;
}
tutem.stop();
good=0;bad=0;
if (musiconly) {
unlockeda=0;
totala=0;
actions.resize(0);
sounds.resize(0);
}
totalactions=actions.length();
if (unlockeda<totala and com=="") {
if (lang==1) rd.add("This level has "+totala+" achievements, and you have unlocked "+unlockeda+". Press enter to continue...",false,true);
if (lang==2) rd.add("Este nivel tiene "+totala+" logros y has desbloqueado "+unlockeda+". Pulsa enter para continuar...",false,true);
}
lasts=100000000;
lasta=100000000;
nopack();
bool finished=false;
yespack();
music.load(name);
bool jing=package.file_exists(jng);
if (!jing and creatingpack) {
alert("jingle error","level start jingle not found. If it shouldn't be named "+jng+".ogg, make sure you define it correctly in the script by using the music jingle=... command.");
exit();
}
if (com=="") playintro(jng,false);
music.volume=volume;
if (musiconly) music.volume=0;
if (seek!=0) music.seek(seek);
music.play();
if (perfectrun) debugmode=true;
while(true) {
wait(3);
if (!music.playing) break;
//do stuff
if (lasta==100000000 && actions.length()!=0) {
for (uint i=0;i<actions.length();i++) {
if (actions[i].duration<=lasta) {
if (actions[i].duration<seek) {
continue;
}
lasta=actions[i].duration;
lastan=i;
lastak=actions[i].key;
}
}
}
//actions method
if (cooler.elapsed>=cooltime) {
cooldown=false;
cooler.pause();
}
keys=keys_pressed();
if (keys.length()==1) {
if (keys[0]==KEY_END && creatingpack) {
rd.say(music.position);
}
else if (keys[0]==KEY_ESCAPE) {
if (creatingpack and com!="") exit();
else startgame(1);
}
if (iskey(keys[0]) && lasta!=100000000 and keys_down().length()==1) {
if (!cooldown) {
if (keys[0]==lastak && lasta!=100000000) {
double distance=music.position-lasta;
if (distance<=-timewindow*2.5) {
actions[lastan].badkey();
}
else if (distance>=-timewindow*2.5+1 && distance<=-timewindow/2-10) {
actions[lastan].early();
actions.remove_at(lastan);
lasta=100000000;
lastan=-1;
}
else if (distance>=timewindow/2 && distance<timewindow/2+10) {
actions[lastan].late();
actions.remove_at(lastan);
lasta=100000000;
}
else {
actions[lastan].play();
if (actions[lastan].type==1) {
actions.remove_at(lastan);
lasta=100000000;
}
}
}
else {
if (actions.length()>0 && lasta!=100000000) {
double distance=music.position-lasta;
actions[lastan].badkey();
if (distance>-timewindow*3 && distance<=timewindow*3) {
//do nothing
}
}
}
lasta=100000000;
}
}
}
if (lasta!=100000000 and key_released(actions[lastan].key) and actions[lastan].type==2 and actions[lastan].held) {
if (!debugmode) {
actions[lastan].stop();
double distance=music.position-actions[lastan].end;
if (distance<=-timewindow) {
actions[lastan].efail();
actions.remove_at(lastan);
lasta=100000000;
}
else if (distance>=-timewindow+1 && distance<=-timewindow/2) {
actions[lastan].efail();
actions.remove_at(lastan);
lasta=100000000;
}
else if (distance>=timewindow/2) {
actions[lastan].efail();
actions.remove_at(lastan);
lasta=100000000;
}
else {
actions[lastan].release();
actions.remove_at(lastan);
lasta=100000000;
}
}
}
if (lasta!=100000000 and music.position>=actions[lastan].end && debugmode && actions[lastan].type==2) {
actions[lastan].release();
actions.remove_at(lastan);
lasta=100000000;
continue;
}
if (lasta!=100000000) {
 if (music.position>=lasta && debugmode) {
if (!actions[lastan].played) actions[lastan].play();
if (actions[lastan].type==1) {
actions.remove_at(lastan);
lasta=100000000;
}
continue;
}
if ((music.position>lasta+timewindow/2+10 && actions[lastan].type==1) or (music.position>actions[lastan].end+timewindow/2+10 && (actions[lastan].type==2 and actions[lastan].held) or (actions[lastan].type==2 and !actions[lastan].held and music.position>=lasta+timewindow/2+10))) {
if (!debugmode) {
if (actions[lastan].type==1) {
actions[lastan].fail();
}
if (actions[lastan].type==2) {
if (!actions[lastan].released) {
if (key_down(actions[lastan].key)) actions[lastan].efail();
if (!key_down(actions[lastan].key)) actions[lastan].fail();
}
}
if (actions[lastan].type==2) actions[lastan].stop();
actions.remove_at(lastan);
lasta=100000000;
}
}
}
//sounds player
if (lasts==100000000 && sounds.length()!=0) {
for (uint i=0;i<sounds.length();i++) {
if (sounds[i].duration<=lasts) {
if (sounds[i].duration<seek) {
continue;
}
lasts=sounds[i].duration;
lastsn=i;
}
}
}
if (music.position>=lasts && lasts!=-1) {
sounds[lastsn].play();
sounds.remove_at(lastsn);
lasts=100000000;
}
}//loop
wait(wait_time);
while (check_playing_sounds()) {
wait(5);
}
//calculate here
if (!perfectrun and !debugmode) {
int oldwell=0;
double total=good+bad;
if (total!=0 or good!=0) {
double wellc=100/total*good;
int well=round(wellc,0);
if (well>=super_n and !perfect) {
oldwell=well;
well=super_n-1;
}
nopack();
if (!creatingpack && well>=ok_n) cash+=well;
if (lang==1) rd.say("let's see...");
if (lang==2) rd.say("veamos...");
pool.play_stationary("calc1",false);
com="";
wait(random(150,300));
pool.play_stationary("calc1",false);
wait(random(350,600));
pool.play_stationary("calc1",false);
wait(random(650,800));
pool.play_stationary("calc1",false);
wait(random(450,600));
if (good>bad) {
pool.play_stationary("calc3",false);
wait(random(1500,3000));
}
else {
pool.play_stationary("calc2",false);
wait(random(1000,2400));
}
yespack();
sound levjing;
timer tinfo;
string message;
int val;
if (well==100) {
val=4;
levjing.load(perfectjng);
if (lang==1) message="That was perfect! Nice!";
if (lang==2) message="Genial! Lo has hecho perfecto!";
}
else if (well<=99 and well>=super_n) {
val=3;
levjing.load(super);
if (lang==1) message="Pretty good!"+well+" percent!";
if (lang==2) message="Muy bien!"+well+" por ciento!";
}
else if (well<=super_n-1 and well>=ok_n) {
val=2;
levjing.load(okjng);
if (lang==1) message="Well... ok. "+well+" percent.";
if (lang==2) message="Bueno... Bien. "+well+" por ciento.";
}
else if (well<ok_n) {
val=1;
levjing.load(failjng);
if (lang==1) message="That was terrible! "+well+" percent.";
if (lang==2) message="Patético! Has jugado muy mal! "+well+" por ciento.";
}
if (oldwell!=0) {
if (lang==2) {
message+=". Vaya, hiciste mal alguna parte importante... Eso no te ha ayudado. es una lástima, porque tenías "+well+" por ciento.";
}
if (lang==1) {
message+=". Pitty, you failed something important in this level... This will not help you. A pitty because you had "+oldwell+" percent.";
}
}
rd.say(message);
wait(600);
levjing.play();
okval=val;
tinfo.restart();
while (!key_pressed(KEY_RETURN) and !key_pressed(KEY_ESCAPE)) {
if (tinfo.elapsed>=10000) {
tinfo.restart();
rd.say(message);
if (lang==1) rd.say("press enter to continue...");
if (lang==2) rd.say("Pulsa enter para continuar...");
}
wait(5);
}
if (get_level(lname)<val) {
if (!creatingpack) set_level(lname,val,pack);
}
else {
if (get_level(lname)!=0) {
}
}
}
else {
rd.say("I cannot calculate your result ...");
wait(1000);
}
if (okval>1 and last and !creatingpack) {
playintro("win_pack");
if (lang==1) get_ach("You beat the "+pack+" pack!");
if (lang==2) get_ach("has completado el pack "+pack+"!");
}
}
startgame(1);
return;
}
void startlev(string lv) {
actiontimes.resize(0);
strict=false;
debugmode=false;
super_n=91;
ok_n=70;
timewindow=150+keycal;
cooltime=0;
unlockeda=0;
totala=0;
tutorial=false;
string macrostuff="";
perfectjng="perfect_jingle";
super="super_jingle";
failjng="fail_jingle";
okjng="ok_jingle";
string inst;
if (lang==1) inst="What do you want to do?";
if (lang==2) inst="Qué quieres hacer?";
reset_preloads();
aliases.delete_all();
presets.delete_all();
//tutorial
string ln=string_left(lv,lv.length()-4);
lname=ln;
olv=ln+".lvl";
enhanced_menu choice;
choice.set_speech_mode(rd.reader_mode);
choice.ats("cancel","cancelar","esc");
if (package.file_exists(ln+".tut") && question_state!=1) {
choice.ats("tutorial","tutorial","tut");
}
choice.ats("play","jugar","play");
//here
if (get_level(ln)>=3) {
if (cash<500) {
choice.ats("You need 500 creds for a perfect run and you have "+cash+".","Necesitas 500 créditos para escuchar el nivel perfecto y solo tienes "+cash+".","esc");
}
else {
choice.ats("perfect run (-500 creds)","escuchar nivel perfecto (-500 créditos)","perfect");
}
}
else {
choice.ats("perfect runs are not available until you have achieved a super","el nivel perfecto solo se puede escuchar cuando obtengas al menos un súper.","esc");
}
if (get_level(ln)>=4) {
choice.ats("listen to this level's soundtrack","escuchar música del nivel","str");
}
else {
choice.ats("You can listen to the soundtrack only when you get a perfect","solo puedes escuchar la música del nivel cuando tengas un perfect.","esc");
}
string r;
if (com!="") {question_state=0;}
if (debugl=="") {
if (com=="") r=choice.run_extended(inst,true,"esc",true);
if (r=="tut") question_state=1;
if (r=="play") question_state=2;
if (r=="perfect") {
question_state=2;
perfectrun=true;
lesscash(500);
}
if (r=="str") {
question_state=2;
musiconly=true;
}
if (r=="esc") {
startgame(2);
return;
}
}
else {
if (tutorial) {
r="tut";
}
else {
r="play";
}
if (r=="tut") question_state=1;
if (r=="play") question_state=2;
}
if (question_state==1) lv=ln+".tut";
if (string_right(lv,4)==".tut") {
tutorial=true;
music.stop();
}
jng=string_left(lv,lv.length()-4)+"j";
actions.resize(0);
sounds.resize(0);
wait_time=0;
seek=0;
int lev_vol=0;
datastream@ f;
@f=package.get_file(lv);
if (@f==null) {
if (lang==1) alert("error","Error opening the level from the pack file.");
if (lang==2) alert("error","Hubo un error al abrir el archivo del nivel desde el paquete.");
exit();
}
string the_string=f.read();
wait_time=0;
for (uint i=1;i<3;i++) {
if (tutorial) {
string[] lines=string_split(the_string,"\r\n",false);
tutes.play_wait();
gotoline=0;
for (uint i=gotoline;i<lines.length();i++) {
if (lines[i]=="jump") {
if (creatingpack) gotoline=i;
}
}
for (uint i=gotoline;i<lines.length();i++) {
string[] w=string_split(lines[i]," ",true);
for (uint i=0;i<w.length();i++) {
if (w[0]=="play") preload_add(w[1]);
}
}
}
if (the_string=="") {
break;
}
string[] lines=string_split(the_string,"\r\n",false);
for (uint i=gotoline;i<lines.length();i++) {
string ach="";
if (tutorial) {
if (key_pressed(KEY_Q)) break;
}
string achie="";
string[] words=string_split(lines[i]," ",true);
curline=i+1;
int result=string_contains(lines[i],"ach=",1);
if (result!=-1) {
ach=string_trim_left(lines[i],result+4);
}
//newcoms
if (words[0]=="play" and tutorial) {
if (words.length()==2) {
pool.play_stationary(words[1],false);
}
else if (words.length()==3) {
if (!tutem.playing) {
alert("bad command","You have a bad play command on line "+curline+". The music isn't playing or sound could not be found.");
exit();
}
if (tutem.position>=string_to_number(words[2])) {
pool.play_stationary(words[1],false);
}
else {
i--;
continue;
}
}
}
else if (words[0]=="stopsounds") {
pool.destroy_all();
}
else if (words[0]=="wait" && tutorial) {
wait(string_to_number(words[1]));
}
else if (words[0]=="interactive" && tutorial) {
string[] params=words;
if (params.length()>2) {
tut_right=0;
tut_count=0;
tut_wrong=0;
enhanced=true;
tut_mus.load(params[1]);
tut_mus.volume=string_to_number(params[2]);
tut_start=string_to_number(params[3]);
tut_finish=string_to_number(params[4]);
intersounds.resize(0);
tut_max=string_to_number(params[5]);
continue;
}
else {
enhanced=false;
//icode
tut_mus.seek(tut_start);
first_iter=true;
tut_mus.play_looped();
while(true) {
// NVGT needs a short yield each iteration so it can pump window/input events.
// Without it this busy loop never sees key presses, so interactive tutorials
// (which worked in BGT's busy loop) fail to register any input at all.
wait(5);
if (key_pressed(KEY_ESCAPE)) {
tut_mus.stop();
if (creatingpack and com!="") exit();
else startgame(1);
}
if (debug && key_pressed(KEY_Z)) {
rd.say(intersounds.length());
rd.say(tut_count);
}
if (tut_count<intersounds.length()) {
if (tut_mus.position>=intersounds[tut_count].time && (intersounds[tut_count].key==0 or first_iter==true)) {
if (intersounds[tut_count].key==0) {
intersounds[tut_count].snd.stop();
intersounds[tut_count].snd.play();
tut_count++;
}
else {
tut_beep.play();
}
}
}
else {//it has a key
}
if (tut_count<intersounds.length()) {
if (key_released(intersounds[tut_count].key) && intersounds[tut_count].held) {
if (tut_mus.position<intersounds[tut_count].end-75+keycal) {
tut_right-=2;
intersounds[tut_count].snd.stop();
//change
tut_early.stop();
tut_early.play();
tut_count++;
continue;
}
else {
intersounds[tut_count].snd.stop();
//change
tut_great.stop();
tut_great.play();
tut_count++;
continue;
}
}
if (intersounds[tut_count].key>0) {
if (key_pressed(intersounds[tut_count].key)) {
if (tut_mus.position>=intersounds[tut_count].time+75+keycal) {
//change
tut_late.stop();
tut_late.play();
tut_right--;
tut_count++;
continue;
}
else if (tut_mus.position<=intersounds[tut_count].time-75+keycal) {
//change
tut_early.stop();
tut_early.play();
tut_right--;
tut_count++;
continue;
}
else if (tut_mus.position<=intersounds[tut_count].time-151+keycal) {
}
else {
//change
intersounds[tut_count].snd.play();
intersounds[tut_count].held=true;
if (intersounds[tut_count].end==0) {
tut_count++;
tut_great.stop();
tut_great.play();

}
tut_right++;
continue;
}
}
}
if (tut_count==intersounds.length()) tut_count=0;
if (intersounds[tut_count].key>0) {
if (intersounds[tut_count].end>0) {
if (key_down(intersounds[tut_count].key) && tut_mus.position>=intersounds[tut_count].end+100+keycal) {
//change
tut_late.stop();
tut_late.play();
intersounds[tut_count].snd.stop();
tut_right--;
tut_right--;
tut_count++;
continue;
}
}
if (tut_mus.position>=intersounds[tut_count].time+150+keycal) {
if (intersounds[tut_count].end==0 or (intersounds[tut_count].end>0 && intersounds[tut_count].held==false)) {
//change
tut_late.stop();
tut_late.play();
tut_right--;
tut_count++;
}
}
}
}
if (tut_mus.position>=tut_finish) {
for (uint i=0;i<intersounds.length();i++) {
intersounds[i].held=false;
intersounds[i].snd.stop();
}
if (tut_right<tut_max) {
tut_mus.seek(tut_start);
first_iter=false;
tut_count=0;
if (tut_right<0) tut_right=0;
}//position
else {
//change
tut_ap.play();
fade2(tut_mus);
break;
}
}
}
}
}
else if (words[0]=="intersound" && enhanced==true) {
string[] params=words;
preload_add(params[1]);
intersound temp;
bool meh=temp.snd.load(params[1]);
if (!meh) alert("can't load",params[1]);
temp.snd.pitch=string_to_number(params[2]);
temp.snd.pan=string_to_number(params[3]);
temp.time=string_to_number(params[4]);
if (params.length()>=6) {
//keys
string[] what=string_split(params[5],"_",true);
if (what[0]=="key") {
if (what[1]=="enter") {
temp.key=KEY_RETURN;
}
else if (what[1]=="space") {
temp.key=KEY_SPACE;
}
else if (what[1]=="up") {
temp.key=KEY_UP;
}
else if (what[1]=="down") {
temp.key=KEY_DOWN;
}
else if (what[1]=="right") {
temp.key=KEY_RIGHT;
}
else if (what[1]=="left") {
temp.key=KEY_LEFT;
}
else if (what[1]=="a") {
temp.key=KEY_A;
}
else if (what[1]=="b") {
temp.key=KEY_B;
}
else if (what[1]=="c") {
temp.key=KEY_C;
}
else if (what[1]=="d")temp.key=KEY_D;
else if (what[1]=="e")temp.key=KEY_E;
else if (what[1]=="f")temp.key=KEY_F;
else if (what[1]=="g")temp.key=KEY_G;
else if (what[1]=="h")temp.key=KEY_H;
else if (what[1]=="i")temp.key=KEY_I;

else if (what[1]=="j")temp.key=KEY_J;

else if (what[1]=="k")temp.key=KEY_K;

else if (what[1]=="l")temp.key=KEY_L;

else if (what[1]=="m")temp.key=KEY_M;

else if (what[1]=="n")temp.key=KEY_N;

else if (what[1]=="o")temp.key=KEY_O;

else if (what[1]=="p")temp.key=KEY_P;

else if (what[1]=="q")temp.key=KEY_Q;

else if (what[1]=="r")temp.key=KEY_R;

else if (what[1]=="s")temp.key=KEY_S;

else if (what[1]=="t")temp.key=KEY_T;

else if (what[1]=="u")temp.key=KEY_U;

else if (what[1]=="v")temp.key=KEY_V;
else if (what[1]=="w")temp.key=KEY_W;
else if (what[1]=="x")temp.key=KEY_X;

else if (what[1]=="y")temp.key=KEY_Y;

else if (what[1]=="z")temp.key=KEY_Z;

else if (what[1]=="1")temp.key=KEY_1;

else if (what[1]=="2")temp.key=KEY_2;

else if (what[1]=="3")temp.key=KEY_3;

else if (what[1]=="4")temp.key=KEY_4;

else if (what[1]=="5")temp.key=KEY_5;

else if (what[1]=="6")temp.key=KEY_6;

else if (what[1]=="7")temp.key=KEY_7;

else if (what[1]=="8")temp.key=KEY_8;
else if (what[1]=="9")temp.key=KEY_9;
else if (what[1]=="0")temp.key=KEY_0;
else {
alert("key error","key not recognized"+what[1]+", for action on line "+curline+". You can use space, enter, right, left, up or down, for now. For more info read parser commands.txt.");
exit();
}
}
//end keys
}
if (params.length()>=7) {
temp.end=string_to_number(params[6]);
}
intersounds.insert_last(temp);
continue;
}
else if (words[0]=="playwait" && tutorial) {
playintro(words[1]);
}

if (words[0]=="text" && tutorial) {
string text="";
if (words.length()==1) {
alert("no text","line "+curline+" has no tutorial text.");
exit();
}
for (uint i=1;i<words.length();i++) {
text+=words[i]+" ";
}
text=string_replace(text,"Ã¡","á",true);
text=string_replace(text,"Ã³","ó",true);
