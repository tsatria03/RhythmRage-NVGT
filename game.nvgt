void achprizes() {
string[] acha=string_split(achievements,"==",true);
if (achievements=="") {
if (lang==1) rd.add("You don't have any achievements. Hit enter to continue",true,true);
if (lang==2) rd.add("No tienes logros todavía. Pulsa enter para salir.",true,true);
start();
return;
}
enhanced_menu ach;
ach.set_speech_mode(rd.reader_mode);
ach.move_path="menu_move";
ach.ats("go back","atrás","esc");
for (int i=0;i<acha.length();i++) {
ach.ats(acha[i],acha[i],"achievement");
}//for
string o;
if (lang==1) o=ach.run_extended("Achievements menu: You have "+acha.length()+" achievements. Press escape when done",true,"esc",false);
if (lang==2) o=ach.run_extended("Menú de logros. Tienes "+acha.length()+" logros. Pulsa escape cuando hayas terminado",true,"esc",false);
while (o!="esc") {
o=ach.run_extended("",true,o,false);
wait(5);
}
start();
return;
}
void get_ach(string str) {
str=string_replace(str,"Ã¡","á",true);
str=string_replace(str,"Ã³","ó",true);
str=string_replace(str,"Ã±","ñ",true);
str=string_replace(str,"Ãº","ú",true);
str=string_replace(str,"Ã­","í",true);
str=string_replace(str,"Ã©","é",true);

string[] acha=string_split(achievements,"==",true);
if (!is_in_array(str,acha)) {
cash+=10*acha.length();
achievements+=str+"==";
achs.load("newach");
achs.stop();
achs.play();
ser();
}
}
void set_level(string level,string value,string pack) {
int whichone=-1;
string info;
ok=unlockinfo.get(pack+".pack",info);
string[] lvl=string_split(info,",,,",true);

for (uint i=0;i<lvl.length();i++) {
if (string_left(lvl[i],level.length())==level) {
whichone=i;
break;
}
}
if (whichone!=-1) {
lvl.remove_at(whichone);
}
lvl.insert_last(level+"==="+value);
string built;
for (uint i=0;i<lvl.length();i++) {
built+=lvl[i]+",,,";
}
unlockinfo.set(pack+".pack",built);
ser();
}
int get_level(string level) {
int whichone=-1;
string info;
string[] test=unlockinfo.get_keys();
ok=unlockinfo.get(pack+".pack",info);
if (!ok) {
return 0;
}
string[] lvl=string_split(info,",,,",true);
for (uint i=0;i<lvl.length();i++) {
if (string_left(lvl[i],level.length())==level) {
whichone=i;
break;
}
}
if (whichone!=-1) {
return string_to_number(string_split(lvl[whichone],"===",true)[1]);
}
return 0;
}
void calibrate_keyboard() {
music.stop();
sound beep;
nopack();
beep.load("beep");
double[] presses;
if (lang==1) rd.add("ok. We will now configure your keyboard. You will hear a beeping noise, and you will have to press the space bar as close to the beep as you can. This will help you if you are playing on a virtual machine. Press enter when ready, press escape to cancel this calibration.",false,true);
if (lang==2) rd.add("Bien, ahora configuraremos tu teclado. Escucharás unos bips, y tendrás que pulsar la tecla espacio lo más cerca que puedas de los pitidos. Esto te ayudará si juegas con una máquina virtual porque tendrás tiempo extra. Pulsa el enter cuando estés preparado. Pulsa escape para salir",false,true);
timer cal;
timer press;
bool beep_started=false;
cal.restart();
while(presses.length()<=12) {
// NVGT needs a short yield here so it can pump window/input events.  The BGT
// busy loop can otherwise consume a full CPU core and stop seeing Space.
wait(1);
if (key_pressed(KEY_ESCAPE)) {
beep.stop();
yespack();
start();
return;
}
if (cal.elapsed>=500) {
cal.restart();
press.restart();
beep.play();
beep_started=true;
}
if (beep_started && key_pressed(KEY_SPACE)) {
if (press.elapsed<200) {
presses.insert_last(press.elapsed);
}
}
}
presses.remove_at(0);
presses.remove_at(0);
double avg=0;
for (uint i=0;i<presses.length();i++) {
avg+=presses[i];
}
avg=avg/presses.length();
avg=round(avg,0);
keycal=avg;
if (lang==1) rd.add("your keyboard delay is "+keycal+"ms. Press enter to go back to the menus.",false,true);
if (lang==2) rd.add("tu retraso del teclado es de "+keycal+"ms. Pulsa enter para volver a los menús.",false,true);
start();
}
void achclear() {
enhanced_menu questions;
questions.ats("yes","si","y");
questions.ats("no!","no!","esc");
questions.set_speech_mode(rd.reader_mode);
string q;
if (lang==1) q=questions.run_extended("Are you sure you want to delete all of your achievements?",true,"esc",true);
if (lang==2) q=questions.run_extended("Seguro que quieres borrar todos tus logros?",true,"esc",true);
if (q=="y") {
achievements="";
ser();
if (lang==1) rd.add("achievements cleared. Press enter.",false,true);
if (lang==2) rd.add("logros eliminados. Pulsa enter.",false,true);
}
start();
return;
}
void getpacks() {
nopack();
if (lang==1) rd.say("retrieving data...");
if (lang==2) rd.say("Consultando servidor...");
downloader dl;
bool dlb;
int percent=0;
packing=true;
http net;
string result="";
if(!net.get("http://oriolgomez.com/rgpacks/packinfo.php"))
{
if (lang==1) rd.say("Network error. sorry!");
if (lang==2) rd.say("Error en la red. Lo siento!");
start();
return;
}
while(!net.complete) {
result+=net.response_body;
wait(5);
}
result+=net.response_body;
if (net.status_code!=200) result="";
if (result=="") {
if (lang==1) rd.say("Network error. sorry!");
if (lang==2) rd.say("Error en la red. Lo siento!");
start();
return;
}
string[] results=string_split(result,".pack",true);
if (results.length()<2) {
if (lang==1) rd.say("Network error. sorry!");
if (lang==2) rd.say("Error en la red. Lo siento!");
start();
return;
}
string[] actualpacks;
for (uint i=0;i<results.length();i=i+2) {
if (!file_exists(path+"packs/"+url_decode(results[i])+".pack")) {
actualpacks.insert_last(url_decode(results[i]));
}
else {
if (file_size(path+"packs/"+url_decode(results[i])+".pack")!=string_to_number(results[i+1])) actualpacks.insert_last(url_decode(results[i]));
}
}
if (actualpacks.length()==0) {
if (lang==1) rd.say("There are no more packs to download! Why don't you make one?");
if (lang==2) rd.say("No hay más paquetes para descargar, por qué no creas tú uno?");
start();
return;
}
if (lang==1) rd.say("Found new packs! Use the up and down arrow to browse, and enter to download. You can cancel with escape.");
if (lang==2) rd.say("Nuevos packs encontrados! Usa las flechas, y enter para seleccionar uno para su descarga. Con Escape vuelves al menú");
int pos=-1;
while (packing) {
if (key_pressed(KEY_ESCAPE)) {
packing=false;
}
if (key_pressed(KEY_DOWN)) {
pos+=1;
if (pos>actualpacks.length()-1) pos=0;
rd.say(url_decode(actualpacks[pos]));
}
if (key_pressed(KEY_UP)) {
pos-=1;
if (pos<0) pos=actualpacks.length()-1;
rd.say(url_decode(actualpacks[pos]));
}
if (key_pressed(KEY_RETURN)) {
if (lang==1) rd.say("Please wait while the pack is downloaded.");
if (lang==2) rd.say("Por favor espera mientras descargamos tu pack.");
dlb=dl.initiate_download("http://oriolgomez.com/rgpacks/"+actualpacks[pos]+".pack",path+"packs/"+url_decode(actualpacks[pos])+".pack");
if (!dlb) {
rd.say("error!");
start();
return;
}//error
else {
while (dl.is_active()) {
dl.monitor();
if (dl.get_percentage()>=percent+2) {
rd.say(dl.get_percentage()+"%");
percent=dl.get_percentage();
}//if bigger
if (key_pressed(KEY_ESCAPE)) {
dl.abort();;
}
// NVGT needs a short yield here so it can pump window/input events; without it
// Escape never registers to cancel the download and the loop pins a CPU core.
wait(5);
}//error
packing=false;
wait(5);
}//while
if (lang==1) rd.say("complete!");
if (lang==2) rd.say("Paquete descargado correctamente!");
}//key return
wait(5);
}
start();
return;
}
double file_size(string filename) {
file s;
bool suc=s.open(filename,"rb");
if (!suc) return -1;
return s.size;
}	
