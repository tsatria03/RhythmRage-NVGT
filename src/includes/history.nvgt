}
if (messages.length()<4) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}

this.rd.say(this.messages[3]);
return true;
}
if (key_down(modifier)&&key_pressed(KEY_5)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<5) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}

this.rd.say(this.messages[4]);
return true;
}
if (key_down(modifier)&&key_pressed(KEY_6)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<6) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}

this.rd.say(this.messages[5]);
return true;
}
if (key_down(modifier)&&key_pressed(KEY_7)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<7) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}

this.rd.say(this.messages[6]);
return true;
}
if (key_down(modifier)&&key_pressed(KEY_8)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<8) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}

this.rd.say(this.messages[7]);
return true;
}
if (key_down(modifier)&&key_pressed(KEY_9)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<9) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}

this.rd.say(this.messages[8]);
return true;
}
if (key_down(modifier)&&key_pressed(KEY_0)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<10) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}

this.rd.say(this.messages[9]);
return true;
}
if (key_down(modifier2)&&key_pressed(KEY_NEXT)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
this.position=0;
this.rd.say(this.messages[this.position]);
return true;
}
if (key_down(modifier2)&&key_pressed(KEY_PRIOR)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
this.position=messages.length()-1;
this.rd.say(this.messages[this.position]);
return true;
}
if (key_pressed(KEY_NEXT)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
this.position--;
if (this.position<0) {
this.position=0;
if (lang==1) this.rd.say("last");
if (lang==2) this.rd.say("último");
}
this.rd.say(this.messages[this.position]);
return true;
}//prior
if (key_pressed(KEY_PRIOR)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
this.position++;
if (this.position>this.messages.length()-1){
this.position=messages.length()-1;
if (lang==1) this.rd.say("first");
if (lang==2) this.rd.say("primero");
};
this.rd.say(this.messages[this.position]);
return true;
}//prior
return false;
}//function
void say(string message,bool interrupt=false) {
this.rd.say(message,interrupt);
}//function
}//class
