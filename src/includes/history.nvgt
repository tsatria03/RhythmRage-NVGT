// Optional key hook for the paused-message loop, set by the game (the level tool leaves it null). Given the
// pressed key it returns "break" to end the pause, "stay" to keep the reader parked on the current message, or
// "" to let the normal handling run. The game uses it for the in-tutorial pause menu without this shared file
// needing to know about any game-specific globals.
funcdef string history_key_hook(int key);
history_key_hook@ history_hook=null;
class message_history {
string[] messages;
bool auto_move_to_end=false;
int modifier=KEY_LMENU;
int modifier2=KEY_LCONTROL;
bool pauses_allowed=true;
int position=0;
int reader_mode=4; //defaults to NVDA because I am cool, can of course change later.
reader rd;
message_history() {
reader_mode=this.rd.init(); //we don't really need to do much more in the constructor.
}
void add(string message,bool interrupt=false,bool pause=false) {
this.rd.say(message,interrupt);
messages.insert_at(0,message);
if (!auto_move_to_end) this.position++;
if (auto_move_to_end) this.position=0;
if (messages.length()>=100) {
messages.remove_last();
}
if (pause && pauses_allowed) {
while (true) {
bool check=this.process(); //we don't want to display an error message if we're checking for a history message while pausing, do we?
if (!check) {
int[] keys=keys_pressed();
if (keys.length()>0) {
// Let the game intercept the key first (used for the in-tutorial pause menu). "break" ends the pause, "stay"
// keeps us parked on the current message, "" (or no hook) falls through to the normal handling below.
string hooked="";
if (@history_hook!=null) hooked=history_hook(keys[0]);
if (hooked=="break") {
break;
}
else if (hooked=="") {
if (keys[0]==KEY_Q) {//key q
this.pauses_allowed=false;
if (lang==1) this.rd.say("OK, no more pauses. Sorry!");
if (lang==2) this.rd.say("OK, me llevo las pausas. Sorry.");
break;
}//else break key q
else if (keys[0]!=KEY_RETURN) {
this.rd.say(message,true);
if (lang==1) this.rd.say("press return to continue.");
if (lang==2) this.rd.say("Pulsa enter para seguir");
}//not return
else if (keys[0]==KEY_RETURN) {
break;
}//return
}
// hooked=="stay": the game consumed the key (e.g. resume) - keep parked on this message.
}//length
}//process check
wait(5);
}//while
}//paused
}//function
bool process() {
if (key_down(modifier)&&key_pressed(KEY_1)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<1) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}
this.rd.say(this.messages[0]);
return true;
}
if (key_down(modifier)&&key_pressed(KEY_2)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<2) {
if (lang==1) rd.say("No more messages.");
if (lang==2) rd.say("No hay más mensajes.");
return true;
}

this.rd.say(this.messages[1]);
return true;
}
if (key_down(modifier)&&key_pressed(KEY_3)) {
if (messages.length()==0) {
if (lang==1) this.rd.say("no history.");
if (lang==2) this.rd.say("no hay historial.");
return true;
}
if (messages.length()<3) {
if (lang==1) rd.say("No more messages.");
