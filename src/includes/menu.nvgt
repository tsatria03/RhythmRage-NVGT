void start() {
if (com!="" and creatingpack) {
startlev(com);
}
if (com!="" and !creatingpack) {
if (lang==1) alert("error","You can only run levels from the command line if you are creating a pack!");
if (lang==2) alert("vaya","solo puedes ejecutar niveles desde la línea de comandos si estás creando un pack.");
}
yespack();
ser();
mp=-1;
vos.stop();
pool.destroy_all();
music.stop();
if (debugl!="") {
nopack();
tut_ap.load("tut_good");
tut_early.load("tut_early");
tut_late.load("tut_late");
tut_great.load("tut_bell");
tut_beep.load("tut_beep");
yespack();
tutorial=true;
startlev(debugl);
}
enhanced_menu menu;
menu.set_callback(menu2,"");

select.load("menu_select");
music.stop();
music.stream("menu_music");
music.volume=menuvol;
music.play_looped();
menu.move_path="menu_move";
menu.set_speech_mode(rd.reader_mode);
menu.ats("level select","jugar nivel","s");
unlocksa=string_split(unlocks,",",true);
packnames=find_files(packdir+"*");
string[] temp;
for (uint i=0;i<packnames.length();i++) {
if (is_in_array(packnames[i],unlocksa)) {
temp.insert_last(packnames[i]);
}
else {
}
}
unlocksa=temp;
checkpack();
unlocksa=temp;
if (unlocksa.length()!=1) {
menu.ats("change pack","cambiar paquete","change");
}
menu.ats("store (current credits "+cash+")","tienda (créditos ahora "+cash+")","store");
menu.ats("compile a pack","compilar un pack","compilepack");
menu.ats("decompile a pack","descompilar un pack","decompilepack");
menu.ats("download new packs","descargar nuevos packs","getpacks");
menu.ats("change language (current language is "+(lang==1?"English":"Spanish")+")","cambiar idioma (idioma actual: "+(lang==1?"inglés":"español")+")","lang");
menu.ats("keyboard delay settings for virtual machines (current delay is "+keycal+"ms)","configurar retraso del teclado para máquinas virtuales (retraso actual es de "+keycal+"ms)","calkey");
menu.ats("achievements","logros","ach");
menu.ats("delete all achievements","borrar todos tus logros","achclear");
menu.ats("restart","reiniciar","restart");
menu.ats("exit","salir","quit");
string o;
// Open focused on the exit option ("quit").
if (lang==2) o=menu.run_extended("Bienvenido! Usa las flechas para seleccionar una opción y pulsa énter. Usa las teclas avanzar y retroceder página para cambiar el volumen de la música",true,"quit",true);
if (lang==1) o=menu.run_extended("Welcome! Use the arrow keys to choose an option, and enter to select it. You can use page up and page down to change the volume of the background music.",true,"quit",true);
yespack();
if (o=="ach") {
select.play();
fade(music);
achprizes();
}
if (o=="achclear") {
select.play();
fade(music);
achclear();
}

if (o=="compilepack") {
select.play();
fade(music);
compilepacks();
}
if (o=="decompilepack") {
select.play();
fade(music);
decompilepacks();
}
if (o=="store") {
select.play();
fade(music);
store();
}
if (o=="getpacks") {
select.play();
fade(music);
getpacks();
}

if (o=="calkey") {
select.play();
fade(music);
calibrate_keyboard();
}
if (o=="lang") {
select.play();
fade(music);
change_language();
}

if (o=="change") {
select.play();
fade(music);
packchange();
}
if (o=="restart") {
select.play();
fade(music);
restart();
return;
}
if (o=="quit") {
// The exit menu item quits straight away, no confirmation.
select.play();
fade(music);
exit();
return;
}
if (o=="esc") {
// Escape in the main menu asks to confirm before quitting so you don't exit by accident. "no" is focused
// first as the safe default, and escaping the prompt also counts as no - only a definite yes quits. The
// selection sound plays on yes (confirming exit), not on opening this prompt.
enhanced_menu confirm;
confirm.ats("yes","si","y");
confirm.ats("no!","no!","n");
confirm.set_speech_mode(rd.reader_mode);
string q;
if (lang==1) q=confirm.run_extended("Are you sure you want to exit?",true,"n",true);
if (lang==2) q=confirm.run_extended("Seguro que quieres salir?",true,"n",true);
if (q=="y") {
select.play();
fade(music);
exit();
return;
}
start();
return;
}
if (o=="s") {
select.play();
fade(music);
startgame(1);
return;
}
}
void change_language() {
enhanced_menu lmenu;
lmenu.set_speech_mode(rd.reader_mode);
lmenu.move_path="menu_move";
lmenu.ats("English","inglés","1");
lmenu.ats("Spanish","español","2");
lmenu.ats("go back","volver","esc");
string o;
if (lang==1) o=lmenu.run_extended("Choose a language.",true,"esc",true);
if (lang==2) o=lmenu.run_extended("Escoge un idioma.",true,"esc",true);
if (o=="esc") {
start();
return;
}
lang=string_to_number(o);
apply_language();
ser();      // persist the choice (no-op while testing a loose pack, like all saves)
start();
}
void startgame(int md) {
perfectrun=false;
musiconly=false;
question_state=2;
if (md==1) {
music.stream("select_level_music");
music.volume=menuvol;
music.play_looped();
}
flist=package.list_files();
string[] levfiles;
last=false;
okval=0;
for (uint i=0;i<flist.length();i++) {
if (string_right(flist[i],4)==".lvl") levfiles.insert_last(flist[i]);
}
levfiles.sort_ascending();
enhanced_menu lmenu;
lmenu.move_path="menu_move";
lmenu.set_callback(checkmenu, "");
lmenu.set_speech_mode(rd.reader_mode);
int levels=0,locked=0,completed=0;
lockedlevels.resize(0);
string levname;
string lock;
if (lang==1) lock="locked";
if (lang==2) lock="bloqueado";
for (uint i=0;i<levfiles.length();i++) {
levname=string_trim_right(levfiles[i],4);
if (get_level(levname)>=2) completed++;   // completed = passed at ok or better, across every level in the pack
//lockcheck
if (get_level(levname)>1 or i==0 or creatingpack) {
levels++;
lmenu.ats(get_line(levfiles[i],0),get_line(levfiles[i],0),levfiles[i]);
}
else {
if (get_level(string_trim_right(levfiles[i-1],4))>1) {
levels++;
lmenu.ats(get_line(levfiles[i],0),get_line(levfiles[i],0),levfiles[i]);
continue;
}
lmenu.ats(get_line(levfiles[i],0),get_line(levfiles[i],0),levfiles[i]);
lockedlevels.insert_last(levfiles[i]);
locked++;
}
}
lmenu.ats("go back","volver","esc");
if (lang==1) lock="You must unlock the previous levels to proceed.";
if (lang==2) lock="Debes desbloquear los niveles anteriores para proceder.";
// Reopen on the level we last had focused this session (set below when a level is chosen), so leaving a
// level with escape and coming back lands you where you were instead of at the top. Fall back to the go
// back item when nothing is remembered or the remembered level isn't part of this pack.
string startpos="esc";
if (levpos!="" and is_in_array(levpos,levfiles)) startpos=levpos;
// When we reopen on a remembered level, checkmenu should still announce its status (perfect, super, etc.) but
// not play the status jingle for that initial focus. It clears this flag the moment you actually navigate.
skipleveljingle=(startpos!="esc");
// Force checkmenu to treat the opening item as a fresh focus so it announces the status, even when we got here
// by pressing escape mid-level - in that path mp still holds the level we were just on, so without this the
// reopened browser would speak only the name and skip the status.
mp="";
// Expose the completed/total counts so the checkmenu callback can announce them when tab is pressed.
levcompleted=completed;
levtotal=levfiles.length();
string o;
if (lang==1) o=lmenu.run_extended("Level select menu: "+levels+" available levels. "+locked+" are locked.",true,startpos,true);
if (lang==2) o=lmenu.run_extended("Selecciona un nivel: "+levels+" niveles disponibles, y "+locked+" están bloqueados.",true,startpos,true);
while (is_in_array(o,lockedlevels)) {
lockerror.stop();
lockerror.play();
o=lmenu.run_extended(lock,true,o,false);
wait(5);
}
if (o=="esc") {
select.play();
//fade(music);
start();
return;
}
else {
levpos=o;   // remember this level so the browser reopens here next time
if (levfiles[levfiles.length()-1]==o) last=true;
startlev(o);
}
}
