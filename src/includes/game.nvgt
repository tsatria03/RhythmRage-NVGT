if (lang==2) alert("Atención!","este pack no tiene el archivo win_pack.ogg, que se usa cuando ganas todos los niveles. Puedes ignorar este mensaje, pero aparecerá cada vez que abras el juego hasta que pongas uno.");
}

if (package.file_exists("newach")) {
achs.load("newach");
}
if (played) music.play_looped();
}
// The in-level pause menu. Items adapt to the context: "skip tutorial" only while a tutorial is playing,
// "restart" only during an actual level. Resume is focused first, and escape out of this menu also resumes.
// Menu UI sounds (menu_move) come from the current game pack, which is already the active storage in a level.
// The caller is responsible for pausing/resuming the right audio around this call.
string pause_menu() {
enhanced_menu pmenu;
pmenu.set_speech_mode(rd.reader_mode);
pmenu.move_path="menu_move";
pmenu.ats("resume","reanudar","resume");
if (tutorial) pmenu.ats("skip tutorial","saltar el tutorial","skip");
if (!tutorial) pmenu.ats("restart","reiniciar","restart");
pmenu.ats("quit","salir","quit");
string o;
if (lang==1) o=pmenu.run_extended("pause menu",true,"resume",true);
if (lang==2) o=pmenu.run_extended("menú de pausa",true,"resume",true);
if (o=="esc") o="resume";
return o;
}
void loadlev(string name,int volume) {
perfect=true;
if (tutorial) {
tutorial=false;
tute.play();
startlev(olv);
return;
}
tutem.stop();
good=0;bad=0;
if (musiconly) {
unlockeda=0;
totala=0;
actions.resize(0);
sounds.resize(0);
}
totalactions=actions.length();
if (unlockeda<totala and com=="") {
if (lang==1) rd.add("This level has "+totala+" achievements, and you have unlocked "+unlockeda+". Press enter to continue...",false,true);
if (lang==2) rd.add("Este nivel tiene "+totala+" logros y has desbloqueado "+unlockeda+". Pulsa enter para continuar...",false,true);
}
lasts=100000000;
lasta=100000000;
nopack();
bool finished=false;
yespack();
music.load(name);
bool jing=package.file_exists(jng);
if (!jing and creatingpack) {
alert("jingle error","level start jingle not found. If it shouldn't be named "+jng+".ogg, make sure you define it correctly in the script by using the music jingle=... command.");
exit();
}
if (com=="") playintro(jng,false);
music.volume=volume;
if (musiconly) music.volume=0;
if (seek!=0) music.seek(seek);
music.play();
if (perfectrun) debugmode=true;
while(true) {
wait(3);
if (!music.playing) break;
// Let the player adjust the level's backing-music volume on the fly, like the menus do. Page down softens
// it (so the action sounds stand out more), page up raises it. These keys aren't gameplay keys, so there's
// no conflict with the action input below.
if (key_pressed(KEY_NEXT)) music.volume=music.volume-3;
if (key_pressed(KEY_PRIOR)) music.volume=music.volume+3;
//do stuff
if (lasta==100000000 && actions.length()!=0) {
for (uint i=0;i<actions.length();i++) {
if (actions[i].duration<=lasta) {
if (actions[i].duration<seek) {
continue;
}
lasta=actions[i].duration;
lastan=i;
lastak=actions[i].key;
}
}
}
//actions method
if (cooler.elapsed>=cooltime) {
cooldown=false;
cooler.pause();
}
keys=keys_pressed();
if (keys.length()==1) {
if (keys[0]==KEY_END && creatingpack) {
rd.say(music.position);
}
else if (keys[0]==KEY_ESCAPE) {
if (perfectrun or musiconly) {
// Perfect run and soundtrack are passive listen modes with nothing to pause, so escape just leaves the level
// and returns to the level select screen, silencing anything still playing.
music.stop();
pool.destroy_all();
for (uint i=0;i<actions.length();i++) actions[i].apool.destroy_all();
if (creatingpack and com!="") exit();
else startgame(1);
}
else {
// A real playthrough: pause and open the pause menu. Freeze everything gameplay was sounding - the backing
// music, the shared sound pool (play/type-1 actions) and every action's own pool (type-2 tap-and-hold).
music.pause();
pool.pause_all();
for (uint i=0;i<actions.length();i++) actions[i].apool.pause_all();
// Note timing rides on music.position, which is frozen by music.pause(), so hits stay aligned. The only
// wall-clock timer is cooler (the misc cooldown= gate); freeze it too, but only while a cooldown is actually
// running - otherwise it is already paused and must stay that way.
if (cooldown) cooler.pause();
string pr=pause_menu();
if (pr=="quit") {
// Silence everything the level was playing before leaving so nothing keeps sounding after escape.
music.stop();
pool.destroy_all();
for (uint i=0;i<actions.length();i++) actions[i].apool.destroy_all();
if (creatingpack and com!="") exit();
else startgame(1);
}
else if (pr=="restart") {
// Replay the current level from the top. Stop everything first, then re-parse via startlev (actions/sounds
// get consumed during play, so we can't reuse them), and set replaying so startlev skips the choice screen.
music.stop();
pool.destroy_all();
for (uint i=0;i<actions.length();i++) actions[i].apool.destroy_all();
replaying=true;
startlev(olv);
return;
}
else {
// resume: unfreeze and carry on playing from where we paused.
music.play();
pool.resume_all();
for (uint i=0;i<actions.length();i++) actions[i].apool.resume_all();
if (cooldown) cooler.resume();
}
}
}
if (iskey(keys[0]) && lasta!=100000000 and keys_down().length()==1) {
if (!cooldown) {
if (keys[0]==lastak && lasta!=100000000) {
double distance=music.position-lasta;
if (distance<=-timewindow*2.5) {
actions[lastan].badkey();
}
else if (distance>=-timewindow*2.5+1 && distance<=-timewindow/2-10) {
actions[lastan].early();
actions.remove_at(lastan);
lasta=100000000;
lastan=-1;
}
else if (distance>=timewindow/2 && distance<timewindow/2+10) {
actions[lastan].late();
actions.remove_at(lastan);
lasta=100000000;
}
else {
actions[lastan].play();
if (actions[lastan].type==1) {
actions.remove_at(lastan);
lasta=100000000;
}
}
}
else {
if (actions.length()>0 && lasta!=100000000) {
double distance=music.position-lasta;
actions[lastan].badkey();
if (distance>-timewindow*3 && distance<=timewindow*3) {
//do nothing
}
}
}
lasta=100000000;
}
}
}
if (lasta!=100000000 and key_released(actions[lastan].key) and actions[lastan].type==2 and actions[lastan].held) {
if (!debugmode) {
actions[lastan].stop();
double distance=music.position-actions[lastan].end;
if (distance<=-timewindow) {
actions[lastan].efail();
actions.remove_at(lastan);
lasta=100000000;
}
else if (distance>=-timewindow+1 && distance<=-timewindow/2) {
actions[lastan].efail();
actions.remove_at(lastan);
lasta=100000000;
}
else if (distance>=timewindow/2) {
actions[lastan].efail();
actions.remove_at(lastan);
lasta=100000000;
}
else {
actions[lastan].release();
actions.remove_at(lastan);
lasta=100000000;
}
}
}
if (lasta!=100000000 and music.position>=actions[lastan].end && debugmode && actions[lastan].type==2) {
actions[lastan].release();
actions.remove_at(lastan);
lasta=100000000;
continue;
}
if (lasta!=100000000) {
 if (music.position>=lasta && debugmode) {
if (!actions[lastan].played) actions[lastan].play();
if (actions[lastan].type==1) {
actions.remove_at(lastan);
lasta=100000000;
}
continue;
}
if ((music.position>lasta+timewindow/2+10 && actions[lastan].type==1) or (music.position>actions[lastan].end+timewindow/2+10 && (actions[lastan].type==2 and actions[lastan].held) or (actions[lastan].type==2 and !actions[lastan].held and music.position>=lasta+timewindow/2+10))) {
if (!debugmode) {
if (actions[lastan].type==1) {
actions[lastan].fail();
}
if (actions[lastan].type==2) {
if (!actions[lastan].released) {
if (key_down(actions[lastan].key)) actions[lastan].efail();
if (!key_down(actions[lastan].key)) actions[lastan].fail();
}
}
if (actions[lastan].type==2) actions[lastan].stop();
actions.remove_at(lastan);
lasta=100000000;
}
}
}
//sounds player
if (lasts==100000000 && sounds.length()!=0) {
for (uint i=0;i<sounds.length();i++) {
if (sounds[i].duration<=lasts) {
if (sounds[i].duration<seek) {
continue;
}
lasts=sounds[i].duration;
lastsn=i;
}
}
}
if (music.position>=lasts && lasts!=-1) {
sounds[lastsn].play();
sounds.remove_at(lastsn);
lasts=100000000;
}
}//loop
wait(wait_time);
while (check_playing_sounds()) {
wait(5);
}
//calculate here
if (!perfectrun and !debugmode) {
int oldwell=0;
double total=good+bad;
if (total!=0 or good!=0) {
double wellc=100/total*good;
int well=round(wellc,0);
if (well>=super_n and !perfect) {
oldwell=well;
well=super_n-1;
}
nopack();
if (!creatingpack && well>=ok_n) cash+=well;
if (lang==1) rd.say("let's see...");
if (lang==2) rd.say("veamos...");
pool.play_stationary("calc1",false);
com="";
wait(random(150,300));
pool.play_stationary("calc1",false);
wait(random(350,600));
pool.play_stationary("calc1",false);
wait(random(650,800));
pool.play_stationary("calc1",false);
wait(random(450,600));
if (good>bad) {
pool.play_stationary("calc3",false);
wait(random(1500,3000));
}
else {
pool.play_stationary("calc2",false);
wait(random(1000,2400));
}
yespack();
sound levjing;
timer tinfo;
string message;
int val;
if (well==100) {
val=4;
levjing.load(perfectjng);
if (lang==1) message="That was perfect! Nice!";
if (lang==2) message="Genial! Lo has hecho perfecto!";
}
else if (well<=99 and well>=super_n) {
val=3;
levjing.load(super);
if (lang==1) message="Pretty good!"+well+" percent!";
if (lang==2) message="Muy bien!"+well+" por ciento!";
}
else if (well<=super_n-1 and well>=ok_n) {
val=2;
levjing.load(okjng);
if (lang==1) message="Well... ok. "+well+" percent.";
if (lang==2) message="Bueno... Bien. "+well+" por ciento.";
}
else if (well<ok_n) {
val=1;
levjing.load(failjng);
if (lang==1) message="That was terrible! "+well+" percent.";
if (lang==2) message="Patético! Has jugado muy mal! "+well+" por ciento.";
}
if (oldwell!=0) {
if (lang==2) {
message+=". Vaya, hiciste mal alguna parte importante... Eso no te ha ayudado. es una lástima, porque tenías "+well+" por ciento.";
}
if (lang==1) {
message+=". Pitty, you failed something important in this level... This will not help you. A pitty because you had "+oldwell+" percent.";
}
}
rd.say(message);
wait(600);
levjing.play();
okval=val;
tinfo.restart();
while (!key_pressed(KEY_RETURN) and !key_pressed(KEY_ESCAPE)) {
if (tinfo.elapsed>=10000) {
tinfo.restart();
rd.say(message);
if (lang==1) rd.say("press enter to continue...");
if (lang==2) rd.say("Pulsa enter para continuar...");
}
wait(5);
}
if (get_level(lname)<val) {
if (!creatingpack) set_level(lname,val,pack);
}
else {
if (get_level(lname)!=0) {
}
}
}
else {
rd.say("I cannot calculate your result ...");
wait(1000);
}
if (okval>1 and last and !creatingpack) {
playintro("win_pack");
if (lang==1) get_ach("You beat the "+pack+" pack!");
if (lang==2) get_ach("has completado el pack "+pack+"!");
}
}
startgame(1);
return;
}
void startlev(string lv) {
actiontimes.resize(0);
strict=false;
debugmode=false;
super_n=91;
ok_n=70;
timewindow=150+keycal;
cooltime=0;
unlockeda=0;
totala=0;
tutorial=false;
string macrostuff="";
perfectjng="perfect_jingle";
super="super_jingle";
failjng="fail_jingle";
okjng="ok_jingle";
string inst;
if (lang==1) inst="What do you want to do?";
if (lang==2) inst="Qué quieres hacer?";
reset_preloads();
aliases.delete_all();
presets.delete_all();
//tutorial
string ln=string_left(lv,lv.length()-4);
lname=ln;
olv=ln+".lvl";
enhanced_menu choice;
choice.set_speech_mode(rd.reader_mode);
choice.ats("cancel","cancelar","esc");
if (package.file_exists(ln+".tut") && question_state!=1) {
choice.ats("tutorial","tutorial","tut");
}
choice.ats("play","jugar","play");
//here
if (get_level(ln)>=3) {
if (cash<500) {
choice.ats("You need 500 creds for a perfect run and you have "+cash+".","Necesitas 500 créditos para escuchar el nivel perfecto y solo tienes "+cash+".","esc");
}
else {
choice.ats("perfect run (-500 creds)","escuchar nivel perfecto (-500 créditos)","perfect");
}
}
else {
choice.ats("perfect runs are not available until you have achieved a super","el nivel perfecto solo se puede escuchar cuando obtengas al menos un súper.","esc");
}
if (get_level(ln)>=4) {
choice.ats("listen to this level's soundtrack","escuchar música del nivel","str");
}
else {
choice.ats("You can listen to the soundtrack only when you get a perfect","solo puedes escuchar la música del nivel cuando tengas un perfect.","esc");
}
string r;
if (com!="") {question_state=0;}
if (replaying) {
// Restarting the current level from the pause menu: skip the tutorial/play choice screen and go straight to a
// normal playthrough.
replaying=false;
r="play";
question_state=2;
}
else if (debugl=="") {
if (com=="") r=choice.run_extended(inst,true,"esc",true);
if (r=="tut") question_state=1;
if (r=="play") question_state=2;
if (r=="perfect") {
question_state=2;
perfectrun=true;
lesscash(500);
}
if (r=="str") {
question_state=2;
musiconly=true;
}
if (r=="esc") {
startgame(2);
return;
}
}
else {
if (tutorial) {
r="tut";
}
else {
r="play";
}
if (r=="tut") question_state=1;
if (r=="play") question_state=2;
}
if (question_state==1) lv=ln+".tut";
if (string_right(lv,4)==".tut") {
tutorial=true;
music.stop();
}
jng=string_left(lv,lv.length()-4)+"j";
actions.resize(0);
sounds.resize(0);
wait_time=0;
seek=0;
int lev_vol=0;
datastream@ f;
@f=package.get_file(lv);
if (@f==null) {
if (lang==1) alert("error","Error opening the level from the pack file.");
if (lang==2) alert("error","Hubo un error al abrir el archivo del nivel desde el paquete.");
exit();
}
string the_string=f.read();
wait_time=0;
for (uint i=1;i<3;i++) {
if (tutorial) {
string[] lines=string_split(the_string,"\r\n",false);
tutes.play_wait();
gotoline=0;
for (uint i=gotoline;i<lines.length();i++) {
if (lines[i]=="jump") {
if (creatingpack) gotoline=i;
}
}
for (uint i=gotoline;i<lines.length();i++) {
string[] w=string_split(lines[i]," ",true);
for (uint i=0;i<w.length();i++) {
if (w[0]=="play") preload_add(w[1]);
}
}
}
if (the_string=="") {
break;
}
string[] lines=string_split(the_string,"\r\n",false);
for (uint i=gotoline;i<lines.length();i++) {
string ach="";
if (tutorial) {
if (key_pressed(KEY_Q)) break;
}
string achie="";
string[] words=string_split(lines[i]," ",true);
curline=i+1;
int result=string_contains(lines[i],"ach=",1);
if (result!=-1) {
ach=string_trim_left(lines[i],result+4);
}
//newcoms
if (words[0]=="play" and tutorial) {
if (words.length()==2) {
pool.play_stationary(words[1],false);
}
else if (words.length()==3) {
if (!tutem.playing) {
alert("bad command","You have a bad play command on line "+curline+". The music isn't playing or sound could not be found.");
exit();
}
if (tutem.position>=string_to_number(words[2])) {
pool.play_stationary(words[1],false);
}
else {
i--;
continue;
}
}
}
else if (words[0]=="stopsounds") {
pool.destroy_all();
}
else if (words[0]=="wait" && tutorial) {
wait(string_to_number(words[1]));
}
else if (words[0]=="interactive" && tutorial) {
string[] params=words;
if (params.length()>2) {
tut_right=0;
tut_count=0;
tut_wrong=0;
enhanced=true;
tut_mus.load(params[1]);
tut_mus.volume=string_to_number(params[2]);
tut_start=string_to_number(params[3]);
tut_finish=string_to_number(params[4]);
intersounds.resize(0);
tut_max=string_to_number(params[5]);
continue;
}
else {
enhanced=false;
//icode
tut_mus.seek(tut_start);
first_iter=true;
tut_mus.play_looped();
while(true) {
// NVGT needs a short yield each iteration so it can pump window/input events.
// Without it this busy loop never sees key presses, so interactive tutorials
// (which worked in BGT's busy loop) fail to register any input at all.
wait(5);
if (key_pressed(KEY_ESCAPE)) {
tut_mus.stop();
if (creatingpack and com!="") exit();
else startgame(1);
}
if (debug && key_pressed(KEY_Z)) {
rd.say(intersounds.length());
rd.say(tut_count);
}
if (tut_count<intersounds.length()) {
if (tut_mus.position>=intersounds[tut_count].time && (intersounds[tut_count].key==0 or first_iter==true)) {
if (intersounds[tut_count].key==0) {
intersounds[tut_count].snd.stop();
intersounds[tut_count].snd.play();
tut_count++;
}
else {
tut_beep.play();
}
}
}
else {//it has a key
}
if (tut_count<intersounds.length()) {
if (key_released(intersounds[tut_count].key) && intersounds[tut_count].held) {
if (tut_mus.position<intersounds[tut_count].end-75+keycal) {
tut_right-=2;
intersounds[tut_count].snd.stop();
//change
tut_early.stop();
tut_early.play();
tut_count++;
continue;
}
else {
intersounds[tut_count].snd.stop();
//change
tut_great.stop();
tut_great.play();
tut_count++;
continue;
}
}
if (intersounds[tut_count].key>0) {
if (key_pressed(intersounds[tut_count].key)) {
if (tut_mus.position>=intersounds[tut_count].time+75+keycal) {
//change
tut_late.stop();
tut_late.play();
tut_right--;
tut_count++;
continue;
}
else if (tut_mus.position<=intersounds[tut_count].time-75+keycal) {
//change
tut_early.stop();
tut_early.play();
tut_right--;
tut_count++;
continue;
}
else if (tut_mus.position<=intersounds[tut_count].time-151+keycal) {
}
else {
//change
intersounds[tut_count].snd.play();
intersounds[tut_count].held=true;
if (intersounds[tut_count].end==0) {
tut_count++;
tut_great.stop();
tut_great.play();

}
tut_right++;
continue;
}
}
}
if (tut_count==intersounds.length()) tut_count=0;
if (intersounds[tut_count].key>0) {
if (intersounds[tut_count].end>0) {
if (key_down(intersounds[tut_count].key) && tut_mus.position>=intersounds[tut_count].end+100+keycal) {
//change
tut_late.stop();
tut_late.play();
intersounds[tut_count].snd.stop();
tut_right--;
tut_right--;
tut_count++;
continue;
}
}
if (tut_mus.position>=intersounds[tut_count].time+150+keycal) {
if (intersounds[tut_count].end==0 or (intersounds[tut_count].end>0 && intersounds[tut_count].held==false)) {
//change
tut_late.stop();
tut_late.play();
tut_right--;
tut_count++;
}
}
}
}
if (tut_mus.position>=tut_finish) {
for (uint i=0;i<intersounds.length();i++) {
intersounds[i].held=false;
intersounds[i].snd.stop();
}
if (tut_right<tut_max) {
tut_mus.seek(tut_start);
first_iter=false;
tut_count=0;
if (tut_right<0) tut_right=0;
}//position
else {
//change
tut_ap.play();
fade2(tut_mus);
break;
}
}
}
}
}
else if (words[0]=="intersound" && enhanced==true) {
string[] params=words;
preload_add(params[1]);
intersound temp;
bool meh=temp.snd.load(params[1]);
if (!meh) alert("can't load",params[1]);
temp.snd.pitch=string_to_number(params[2]);
temp.snd.pan=string_to_number(params[3]);
temp.time=string_to_number(params[4]);
if (params.length()>=6) {
//keys
string[] what=string_split(params[5],"_",true);
if (what[0]=="key") {
if (what[1]=="enter") {
temp.key=KEY_RETURN;
}
else if (what[1]=="space") {
temp.key=KEY_SPACE;
}
else if (what[1]=="up") {
temp.key=KEY_UP;
}
else if (what[1]=="down") {
temp.key=KEY_DOWN;
}
else if (what[1]=="right") {
temp.key=KEY_RIGHT;
}
else if (what[1]=="left") {
temp.key=KEY_LEFT;
}
else if (what[1]=="a") {
temp.key=KEY_A;
}
else if (what[1]=="b") {
temp.key=KEY_B;
}
else if (what[1]=="c") {
temp.key=KEY_C;
}
else if (what[1]=="d")temp.key=KEY_D;
else if (what[1]=="e")temp.key=KEY_E;
else if (what[1]=="f")temp.key=KEY_F;
else if (what[1]=="g")temp.key=KEY_G;
