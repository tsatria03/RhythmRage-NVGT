else if (what[1]=="3")temp.key=KEY_3;

else if (what[1]=="4")temp.key=KEY_4;

else if (what[1]=="5")temp.key=KEY_5;

else if (what[1]=="6")temp.key=KEY_6;

else if (what[1]=="7")temp.key=KEY_7;

else if (what[1]=="8")temp.key=KEY_8;
else if (what[1]=="9")temp.key=KEY_9;
else if (what[1]=="0")temp.key=KEY_0;
else {
alert("key error","key not recognized"+what[1]+", for action on line "+curline+". You can use space, enter, right, left, up or down, for now. For more info read parser commands.txt.");
exit();
}
}
//end keys
}
if (params.length()>=7) {
temp.end=string_to_number(params[6]);
}
intersounds.insert_last(temp);
continue;
}
else if (words[0]=="playwait" && tutorial) {
playintro(words[1]);
}

if (words[0]=="text" && tutorial) {
string text="";
if (words.length()==1) {
alert("no text","line "+curline+" has no tutorial text.");
exit();
}
for (uint i=1;i<words.length();i++) {
text+=words[i]+" ";
}
text=string_replace(text,"Ã¡","á",true);
text=string_replace(text,"Ã³","ó",true);
text=string_replace(text,"Ã±","ñ",true);
text=string_replace(text,"Ãº","ú",true);
text=string_replace(text,"Ã­","í",true);
text=string_replace(text,"Ã©","é",true);
rd.add(text,false,true);
tuten.stop();
tuten.play();
}
else if (words[0]=="misc" && !tutorial) {
for (uint i=1;i<words.length();i++) {
string[] what=string_split(words[i],"=",true);
if (what[0]=="super") {
super_n=string_to_number(what[1]);
if (super_n==0) {
if (lang==1) alert("error","Super value is set wrong.");
if (lang==2) alert("error","el valor de súper no se ha configurado bien.");
exit();
}
}
else if (what[0]=="cooldown") {
cooltime=string_to_number(what[1]);
if (!string_is_digits(what[1])) {
if (lang==1) alert("error","cooldown value is set wrong.");
if (lang==2) alert("error","el valor de cooldown no se ha configurado bien.");
exit();
}
}
else if (what[0]=="reaction") {
timewindow=string_to_number(what[1])+keycal;
if (!string_is_digits(what[1])) {
if (lang==1) alert("error","reaction value is set wrong.");
if (lang==2) alert("error","el valor de reaction no se ha configurado bien.");
exit();
}
}
else if (what[0]=="ok") {
ok_n=string_to_number(what[1]);
if (ok_n==0) {
if (lang==1) alert("error","ok value is set wrong.");
if (lang==2) alert("error","el valor de ok no se ha configurado bien.");
exit();
}
}
}
}
else if (words[0]=="action" && !tutorial) {
int pan=0;
int type=1;
string endsnd;
int pitch=100;
string alias;
int time=0;
int volume=0;
string name;
string failsound="fail_generic";
int etime=0;
string bksound="fail_generic";
int key=0;
string earlysound="fail_generic";
string efailsound="fail_generic";
bool kp=false;
string latesound="fail_generic";
for (uint i=1;i<words.length();i++) {
string[] what=string_split(words[i],"=",true);
if (what[0]=="time") {
time=string_to_number(what[1]);
if (time==0) {
alert("Time error","time cannot be 0. Line "+curline+": "+lines[curline]);
exit();
}
}
else if (what[0]=="end" && !tutorial) {
type=2;
etime=string_to_number(what[1]);
if (etime==0) {
alert("end Time error","time cannot be 0. Line "+curline);
exit();
}
}
else if (what[0]=="ends" && !tutorial) {
type=2;
endsnd=what[1];
}
else if (what[0]=="volume" && !tutorial) {
volume=string_to_number(what[1]);
}//volume
else if (what[0]=="pan" && !tutorial) {
pan=string_to_number(what[1]);
}//volume
else if (what[0]=="pitch" && !tutorial) {
pitch=string_to_number(what[1]);
}
else if (what[0]=="name") {
name=what[1];
}
else if (what[0]=="alias") {
alias=what[1];
}
else if (what[0]=="key") {
if (what[1]=="enter") {
key=KEY_RETURN;
}
else if (what[1]=="space") {
key=KEY_SPACE;
}
else if (what[1]=="up") {
key=KEY_UP;
}
else if (what[1]=="down") {
key=KEY_DOWN;
}
else if (what[1]=="right") {
key=KEY_RIGHT;
}
else if (what[1]=="left") {
key=KEY_LEFT;
}
else if (what[1]=="a") {
key=KEY_A;
}
else if (what[1]=="b") {
key=KEY_B;
}
else if (what[1]=="c") {
key=KEY_C;
}
else if (what[1]=="d")key=KEY_D;
else if (what[1]=="e")key=KEY_E;
else if (what[1]=="f")key=KEY_F;
else if (what[1]=="g")key=KEY_G;
else if (what[1]=="h")key=KEY_H;
else if (what[1]=="i")key=KEY_I;

else if (what[1]=="j")key=KEY_J;

else if (what[1]=="k")key=KEY_K;

else if (what[1]=="l")key=KEY_L;

else if (what[1]=="m")key=KEY_M;

else if (what[1]=="n")key=KEY_N;

else if (what[1]=="o")key=KEY_O;

else if (what[1]=="p")key=KEY_P;

else if (what[1]=="q")key=KEY_Q;

else if (what[1]=="r")key=KEY_R;

