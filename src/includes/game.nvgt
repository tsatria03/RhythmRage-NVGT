else if (what[0]=="kp") {
kp=true;
}
else if (what[0]=="fail") {
failsound=what[1];
if (!package.file_exists(failsound)) {
alert("error","fail sound doesn't exist. "+failsound+", on line "+curline);
exit();
}
}
else if (what[0]=="efail") {
efailsound=what[1];
type=2;
if (!package.file_exists(efailsound)) {
alert("error","end fail sound for tap and hold action doesn't exist. "+efailsound+", on line "+curline);
exit();
}
}
else if (what[0]=="miss") {
bksound=what[1];
if (!package.file_exists(bksound)) {
alert("error","miss sound doesn't exist. "+bksound+", on line "+curline);
exit();
}
}
else if (what[0]=="early") {
earlysound=what[1];
