alert("error","Macro time on line "+curline+" was either not specified or not a proper number.");
exit();
}
string prs;
for (uint i=0;i<macro.length();i++) {
if (presets.exists(macro[i])) {
presets.get(macro[i],prs);
int diff,added,ftime,fend,eadded,ediff;
fend=0;
if (i==0) {
//get ftime
int timen=0,etimen=0;
string[] w=string_split(prs," ",true);
for (uint i=0;i<w.length();i++) {
