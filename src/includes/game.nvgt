void ser() {
if (creatingpack) {
return;
}
//if (!SCRIPT_COMPILED) return;
dictionary data;
data.set("cash",cash);
data.set("lang",lang);
data.set("keycal",keycal);
data.set("menuvol",menuvol);
data.set("levpos",levpos);
data.set("unlocks",unlocks);
data.set("pack",pack);
//save unlocks here
string[] save=unlockinfo.get_keys();
string savea;
for (uint i=0;i<save.length();i++) {
ok=unlockinfo.get(save[i],savea);
if (!ok) {
if (lang==1) 
alert("error","error saving unlocked level information.");
if (lang==2) 
alert("error","Hubo un error al guardar tu información sobre paquetes desbloqueados. Puede que encuentres algún problema.");
break;
}
data.set("u."+save[i],savea);
for (uint u=0;u<savea.length();u++) {
}
}
data.set("achievements",achievements);
string srld=serialize(data);
string esrld=string_encrypt(srld,"soyelputoamo");
file fld;
fld.open(path+"data/saves/rg.dat","wb");
fld.write(esrld);
fld.close();
}
void deser() {
cash=0;
unlocks="default.pack,";
if(file_exists(path+"data/saves/rg.dat")) {
file fld;
fld.open(path+"data/saves/rg.dat","rb");
string dsr=fld.read();
dsr=string_decrypt(dsr,"soyelputoamo");
dictionary data=deserialize(dsr);
string[] datas=data.get_keys();
for (uint i=0;i<datas.length();i++) {
}
for (uint i=0;i<data.get_keys().length();i++) {
}
if (data.exists("achievements")) 
data.get("achievements",achievements);
if (data.exists("cash"))
data.get("cash",cash);
if (data.exists("lang"))
data.get("lang",lang);
if (data.exists("keycal"))
data.get("keycal",keycal);
if (data.exists("menuvol"))
data.get("menuvol",menuvol);
if (data.exists("levpos"))
data.get("levpos",levpos);
// Restore the pack the player last had open. Skip while creatingpack, because generate_packs() (which runs
// before deser) has already selected the loose test folder and we must not overwrite it. Fall back to the
// default pack if the saved one no longer exists, so a deleted pack can't trigger the pack-error exit.
if (!creatingpack && data.exists("pack")) {
data.get("pack",pack);
if (!file_exists(path+"data/packs/"+pack+".pack")) pack="default";
}
if (data.exists("unlocks"))
data.get("unlocks",unlocks);
if (unlocks=="") unlocks+="default.pack,";
string[] levels=string_split(unlocks,".pack,",true);
int curl;
for (uint i=0;i<levels.length();i++) {
curl=i;
string result;
ok=data.get("u."+levels[i]+".pack",result);
if (ok) {
string[] lvl=string_split(result,",,,",true);
for (uint i=0;i<lvl.length();i++) {
string[] lvln=string_split(lvl[i],"===",true);
set_level(lvln[0],lvln[1],levels[curl]);
}
}
}
}
else {
ser();
}
}
// First-letter search over a list of pack filenames: next entry (cycling from current) starting with letter, else -1.
int next_first_letter(string[]@ list, int current, string letter) {
int count=list.length();
if (count==0) return -1;
if (current<0) current=count-1;
for (int i=1;i<=count;i++) {
int idx=(current+i)%count;
if (list[idx].lower().starts_with(letter)) return idx;
}
return -1;
}
// Announce and preview the pack at idx (switch to its encrypted storage, play its name sound, then restore).
void preview_pack(string[]@ list, int idx) {
packer.stop();
set_sound_storage(path+"data/packs/"+list[idx]);
rd.say(list[idx]);
string key=string_replace(list[idx],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}
void store() {
nopack();
if (!debug && cash<1000) {
if (lang==1) rd.add("You don't have enough credits to buy a new pack... You only have "+cash+" and you need at least 1000!",false,true);
if (lang==2) rd.add("No tienes suficientes créditos para comprar un nuevo paquete, necesitas al menos 1000 y tienes "+cash,false,true);
start();
return;
}
if (lang==1) rd.say("Use the arrow keys to choose a pack, and enter to select it.");
if (lang==2) rd.say("Usa las flechas para escoger un paquete y énter para seleccionarlo.");
packnames.resize(0);
packfiles.resize(0);
packing=true;
packfiles=find_files(path+"data/packs/*.pack");
unlocksa=string_split(unlocks,",",true);
for (uint i=0;i<packfiles.length();i++) {
if (!is_in_array(packfiles[i],unlocksa)) {
packnames.insert_at(0,packfiles[i]);
}
}
if (packnames.length()==0) {
if (lang==1) rd.add("You've bought all the available packs.",false,true);
if (lang==2) rd.add("Ya has comprado todos los packs.",false,true);
start();
return;
}
else {
mpos=-1;
get_characters(); // discard input typed before the browser opened
while (packing) {
packloop();
}//loop
}//if packnames 0
}//function
void packchange() {
nopack();
if (lang==1) rd.say("Use the arrow keys to choose a pack, and enter to select it.");
if (lang==2) rd.say("Usa las flechas para escoger un paquete y énter para seleccionarlo.");
packing=true;
unlocksa=string_split(unlocks,",",true);
packnames=find_files(path+"data/packs/*");
string[] temp;
for (uint i=0;i<packnames.length();i++) {
if (is_in_array(packnames[i],unlocksa)) {
temp.insert_last(packnames[i]);
}
else {
}
}
unlocksa=temp;
mpos=-1;
if (temp.length()==0) {
if (lang==1) rd.add("There aren't any packs to change to! Press enter.",false,true);
if (lang==2) rd.add("No hay packs para cambiar!",false,true);
start();
return;
}
get_characters(); // discard input typed before the browser opened
while (packing) {
packloop2();
}//loop
}//function
void packloop() {
if(key_pressed(KEY_ESCAPE)) {
pool.destroy_all();
music.stop();
packer.stop();
packing=false;
start();
return;
}
if (key_pressed(KEY_TAB)) {
rd.say(cash);
}
if(key_repeating(KEY_DOWN) or key_repeating(KEY_RIGHT)) {
mpos+=1;
if(mpos>=packnames.length()) {
mpos=0;
}
packer.stop();
set_sound_storage(path+"data/packs/"+packnames[mpos]);
rd.say(packnames[mpos]);
string key=string_replace(packnames[mpos],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}
if(key_repeating(KEY_UP) or key_repeating(KEY_LEFT)) {
mpos-=1;
if(mpos<0) {
mpos=packnames.length()-1;
}
packer.stop();
set_sound_storage(path+"data/packs/"+packnames[mpos]);
rd.say(packnames[mpos]);
string key=string_replace(packnames[mpos],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}
string chars=get_characters();
if (chars!="") {
int idx=next_first_letter(packnames, mpos, chars.substr(0,1).lower());
if (idx>=0) { mpos=idx; preview_pack(packnames, mpos); }
}
if(key_pressed(KEY_RETURN)) {
if (mpos>=0) {
unlocks=unlocks+packnames[mpos]+",";
if (!debug) lesscash(1000);
packer.stop();
packer.stream("buypack");
packer.play_wait();
pack=string_trim_right(packnames[mpos],5);
load_pack();
creatingpack=false;
ser();
start();
return;
}
wait(5);
}
wait(5);
}
void packloop2() {
if(key_pressed(KEY_ESCAPE)) {
packer.stop();
packing=false;
start();
return;
}
if (key_pressed(KEY_TAB)) {
nopack();
vo.speak(cash);
while (vo.speak_next()==1) {
packloop2();
wait(5);
}
}
if(key_repeating(KEY_DOWN) or key_repeating(KEY_RIGHT)) {
mpos+=1;
if(mpos>=unlocksa.length()) {
mpos=0;
}
packer.stop();
set_sound_storage(path+"data/packs/"+unlocksa[mpos]);
rd.say(unlocksa[mpos]);
string key=string_replace(unlocksa[mpos],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}

if(key_repeating(KEY_UP) or key_repeating(KEY_LEFT)) {
mpos-=1;
if(mpos<0) {
mpos=unlocksa.length()-1;
}
packer.stop();
set_sound_storage(path+"data/packs/"+unlocksa[mpos]);
rd.say(unlocksa[mpos]);
string key=string_replace(unlocksa[mpos],".pack","",true)+"guillemandoriolftw";
set_sound_decryption_key(key,false);
packer.stream("name");
packer.play();
set_sound_decryption_key(pack+"guillemandoriolftw",false);
nopack();
}
string chars=get_characters();
if (chars!="") {
int idx=next_first_letter(unlocksa, mpos, chars.substr(0,1).lower());
if (idx>=0) { mpos=idx; preview_pack(unlocksa, mpos); }
}
if(key_pressed(KEY_RETURN)) {
if (mpos>=0) {
packer.stop();
packing=false;
pack=string_trim_right(unlocksa[mpos],5);
load_pack();
creatingpack=false;
ser();
start();
return;
}
}
wait(5);
}
void load_pack() {
yespack();
alreadyplayed=false;
levpos="";   // new pack, so forget the remembered level select position
}
void checkpack() {
bool played;
if (music.playing) {
music.stop();
played=true;
}
bool suc=package.open(path+"data/packs/"+pack+".pack");
if (!suc) {
