timen=i;
}
if (string_contains(w[i],"end=",1)!=-1) {
etimen=i;
}
}
string[] p=string_split(w[timen],"=",true);
ftime=string_to_number(p[1]);
if (etimen!=0) {
string[] p=string_split(w[etimen],"=",true);
fend=string_to_number(p[1]);
}
int result=string_contains(prs,"ach=",1);
if (result!=-1) {
achie=string_trim_left(prs,result+4);
ach=achie;
}
else {
ach=""; achie="";
}
if (ach!="") {
prs=string_left(prs,result);
}
prs=prs+" time="+mrt;
if (fend!=0) {
prs=prs+" time="+mrt+" end="+fend;
}
if (ach!="") {
prs=prs+"ach="+ach;
string[] acha=string_split(achievements,"==",true);
totala++;
if (is_in_array(ach,acha)) {
unlockeda++;
}
}
macrostuff+=prs+"\r\n";
//alert("compiled macro",prs);
}
else {
int time=0,timen,etime=0,etimen;
string[] w=string_split(prs," ",true);
for (uint i=0;i<w.length();i++) {
if (string_contains(w[i],"time=",1)!=-1) {
timen=i;
}
if (string_contains(w[i],"time=",1)!=-1) {
timen=i;
}
if (string_contains(w[i],"end=",1)!=-1) {
etimen=i;
string[] k=string_split(w[i],"=",true);
fend=string_to_number(k[1]);
}
}
string[] p=string_split(w[timen],"=",true);
if (etimen==0) fend=0;
time=string_to_number(p[1]);
if (fend!=0) {
string[] p=string_split(w[etimen],"=",true);
etime=string_to_number(p[1]);
if (etime==0) {
alert("bug","There is a bug with the tap hold macro programming code, let me know the contents of line "+curline+" and I will try to fix.");
exit();
}
}
if (time==0) {
alert("bug","There is a bug with the macro programming code, let me know the contents of line "+curline+" and I will try to fix.");
exit();
}
added=time-ftime;
diff=mrt-added;
if (fend!=0) {
eadded=etime-ftime;
ediff=fend-eadded;
}
int result=string_contains(prs,"ach=",1);
if (result!=-1) {
achie=string_trim_left(prs,result+4);
ach=achie;
}
else {
ach=""; achie="";
}
if (ach!="") {
prs=string_left(prs,result);
}
prs=prs+" time="+(mrt+added);
if (fend!=0) {
prs=prs+" end="+(mrt+eadded);
}
if (ach!="") {
prs=prs+"ach="+ach;
string[] acha=string_split(achievements,"==",true);
totala++;
if (is_in_array(ach,acha)) {
unlockeda++;
}
}
macrostuff+=prs+"\r\n";
//alert("compiled macro",prs);
}
}
else {
alert("macro error","Non existing macro preset found "+macro[i]+" on line "+curline);
exit();
}
}
//if (macro.length()<2) {
//alert("bad macro","You have a malformed macro on line "+curline+". only "+macro.length()+" actions were found and you need at least 2.");
//}
}
else {
if (lines[i][0]!="/" and i!=0) {
}
}
}//each line loop
the_string=macrostuff;
}//loop twice
loadlev(ln,lev_vol);
}//function
void achprizes() {
string[] acha=string_split(achievements,"==",true);
if (achievements=="") {
if (lang==1) rd.add("You don't have any achievements. Hit enter to continue",true,true);
if (lang==2) rd.add("No tienes logros todavía. Pulsa enter para salir.",true,true);
start();
return;
}
enhanced_menu ach;
ach.set_speech_mode(rd.reader_mode);
ach.move_path="menu_move";
ach.ats("go back","atrás","esc");
for (int i=0;i<acha.length();i++) {
ach.ats(acha[i],acha[i],"achievement");
}//for
string o;
if (lang==1) o=ach.run_extended("Achievements menu: You have "+acha.length()+" achievements. Press escape when done",true,"esc",false);
if (lang==2) o=ach.run_extended("Menú de logros. Tienes "+acha.length()+" logros. Pulsa escape cuando hayas terminado",true,"esc",false);
while (o!="esc") {
o=ach.run_extended("",true,o,false);
wait(5);
}
start();
return;
}
void get_ach(string str) {
str=string_replace(str,"Ã¡","á",true);
str=string_replace(str,"Ã³","ó",true);
str=string_replace(str,"Ã±","ñ",true);
str=string_replace(str,"Ãº","ú",true);
str=string_replace(str,"Ã­","í",true);
str=string_replace(str,"Ã©","é",true);

string[] acha=string_split(achievements,"==",true);
if (!is_in_array(str,acha)) {
cash+=10*acha.length();
achievements+=str+"==";
achs.load("newach");
achs.stop();
achs.play();
ser();
}
}
void set_level(string level,string value,string pack) {
int whichone=-1;
string info;
ok=unlockinfo.get(pack+".pack",info);
string[] lvl=string_split(info,",,,",true);

for (uint i=0;i<lvl.length();i++) {
if (string_left(lvl[i],level.length())==level) {
whichone=i;
break;
}
}
if (whichone!=-1) {
lvl.remove_at(whichone);
}
lvl.insert_last(level+"==="+value);
string built;
for (uint i=0;i<lvl.length();i++) {
built+=lvl[i]+",,,";
}
unlockinfo.set(pack+".pack",built);
ser();
}
int get_level(string level) {
int whichone=-1;
string info;
string[] test=unlockinfo.get_keys();
ok=unlockinfo.get(pack+".pack",info);
if (!ok) {
return 0;
}
string[] lvl=string_split(info,",,,",true);
for (uint i=0;i<lvl.length();i++) {
if (string_left(lvl[i],level.length())==level) {
whichone=i;
break;
}
}
if (whichone!=-1) {
return string_to_number(string_split(lvl[whichone],"===",true)[1]);
}
return 0;
}
void calibrate_keyboard() {
music.stop();
sound beep;
nopack();
beep.load("beep");
double[] presses;
if (lang==1) rd.add("ok. We will now configure your keyboard. You will hear a beeping noise, and you will have to press the space bar as close to the beep as you can. This will help you if you are playing on a virtual machine. Press enter when ready, press escape to cancel this calibration.",false,true);
if (lang==2) rd.add("Bien, ahora configuraremos tu teclado. Escucharás unos bips, y tendrás que pulsar la tecla espacio lo más cerca que puedas de los pitidos. Esto te ayudará si juegas con una máquina virtual porque tendrás tiempo extra. Pulsa el enter cuando estés preparado. Pulsa escape para salir",false,true);
timer cal;
timer press;
bool beep_started=false;
cal.restart();
while(presses.length()<=12) {
// NVGT needs a short yield here so it can pump window/input events.  The BGT
// busy loop can otherwise consume a full CPU core and stop seeing Space.
wait(1);
if (key_pressed(KEY_ESCAPE)) {
beep.stop();
yespack();
start();
return;
}
if (cal.elapsed>=500) {
cal.restart();
press.restart();
beep.play();
beep_started=true;
}
if (beep_started && key_pressed(KEY_SPACE)) {
if (press.elapsed<200) {
presses.insert_last(press.elapsed);
}
}
}
presses.remove_at(0);
presses.remove_at(0);
double avg=0;
for (uint i=0;i<presses.length();i++) {
avg+=presses[i];
}
avg=avg/presses.length();
avg=round(avg,0);
keycal=avg;
if (lang==1) rd.add("your keyboard delay is "+keycal+"ms. Press enter to go back to the menus.",false,true);
if (lang==2) rd.add("tu retraso del teclado es de "+keycal+"ms. Pulsa enter para volver a los menús.",false,true);
start();
}
void achclear() {
enhanced_menu questions;
questions.ats("yes","si","y");
questions.ats("no!","no!","esc");
questions.set_speech_mode(rd.reader_mode);
string q;
if (lang==1) q=questions.run_extended("Are you sure you want to delete all of your achievements?",true,"esc",true);
if (lang==2) q=questions.run_extended("Seguro que quieres borrar todos tus logros?",true,"esc",true);
if (q=="y") {
achievements="";
ser();
if (lang==1) rd.add("achievements cleared. Press enter.",false,true);
if (lang==2) rd.add("logros eliminados. Pulsa enter.",false,true);
}
start();
return;
}
void getpacks() {
nopack();
if (lang==1) rd.say("retrieving data...");
if (lang==2) rd.say("Consultando servidor...");
// Pack server root: the index (pack_index.txt) sits here, and the downloadable packs live in the packs/
// subfolder below it (packbase+"packs/"+<name>.pack).
string packbase="http://reality-breaker-studios.net/RhythmRage/";
downloader dl;
bool dlb;
int percent=0;
packing=true;
http net;
string result="";
if(!net.get(packbase+"pack_index.txt"))
{
if (lang==1) rd.say("Network error. sorry!");
if (lang==2) rd.say("Error en la red. Lo siento!");
start();
return;
}
while(!net.complete) {
result+=net.response_body;
wait(5);
}
result+=net.response_body;
// A non-200 status is a real server problem, so treat that as a network error. But a reachable-yet-empty
// index (HTTP 200 with a blank body) is NOT an error - it just means no packs are listed. Let that fall
// through to the "there are no packs" message below instead of falsely blaming the connection.
if (net.status_code!=200) {
if (lang==1) rd.say("Network error. sorry!");
if (lang==2) rd.say("Error en la red. Lo siento!");
start();
return;
}
// pack_index.txt lists one pack per line: "<name>.pack". Split each line at ".pack" and take everything
// before it (names may contain spaces); anything after ".pack" is ignored, so an older index that still has
// a trailing size on each line also parses fine. Offer a pack only if the player doesn't already have a file
// by that name (there is no size/version comparison - that used to re-list already-downloaded packs).
string[] lines=string_split(result,"\n",false);
string[] actualpacks;
for (uint i=0;i<lines.length();i++) {
string line=string_replace(lines[i],"\r","",true);
int p=string_contains(line,".pack",1);
if (p==-1) continue;
string name=string_left(line,p);
if (name=="") continue;
string local=path+"data/packs/"+name+".pack";
if (!file_exists(local)) actualpacks.insert_last(name);
}
if (actualpacks.length()==0) {
if (lang==1) rd.say("There are no more packs to download! Why don't you make one?");
if (lang==2) rd.say("No hay más paquetes para descargar, por qué no creas tú uno?");
start();
return;
}
if (lang==1) rd.say("Found new packs! Use the arrow keys to browse, and enter to download. You can cancel with escape.");
if (lang==2) rd.say("Nuevos packs encontrados! Usa las flechas, y enter para seleccionar uno para su descarga. Con Escape vuelves al menú");
int pos=-1;
get_characters(); // discard input typed before the browser opened
while (packing) {
if (key_pressed(KEY_ESCAPE)) {
packing=false;
}
if (key_repeating(KEY_DOWN) or key_repeating(KEY_RIGHT)) {
pos+=1;
if (pos>actualpacks.length()-1) pos=0;
rd.say(actualpacks[pos]);
}
if (key_repeating(KEY_UP) or key_repeating(KEY_LEFT)) {
pos-=1;
if (pos<0) pos=actualpacks.length()-1;
rd.say(actualpacks[pos]);
}
string chars=get_characters();
if (chars!="") {
int idx=next_first_letter(actualpacks, pos, chars.substr(0,1).lower());
if (idx>=0) { pos=idx; rd.say(actualpacks[pos]); }
}
if (key_pressed(KEY_RETURN)) {
if (lang==1) rd.say("Please wait while the pack is downloaded.");
if (lang==2) rd.say("Por favor espera mientras descargamos tu pack.");
dlb=dl.initiate_download(packbase+"packs/"+actualpacks[pos]+".pack",path+"data/packs/"+actualpacks[pos]+".pack");
if (!dlb) {
rd.say("error!");
start();
return;
}//error
else {
while (dl.is_active()) {
dl.monitor();
if (dl.get_percentage()>=percent+2) {
beep_percentage(dl.get_percentage());
percent=dl.get_percentage();
}//if bigger
if (key_pressed(KEY_ESCAPE)) {
dl.abort();;
}
// NVGT needs a short yield here so it can pump window/input events; without it
// Escape never registers to cancel the download and the loop pins a CPU core.
wait(5);
}//error
packing=false;
wait(5);
}//while
if (lang==1) rd.say("complete!");
if (lang==2) rd.say("Paquete descargado correctamente!");
}//key return
wait(5);
}
start();
return;
}
