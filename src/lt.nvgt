#include "bgt_compat.nvgt"
int lang=1;
bool acopy;
string running;
timer unlock;
bool lock=false;
timer mover;
enhanced_menu pm;
string[] files;
double markpos;
double setting2=1;
double curbpm;
int curmark;
double songstart=0;
bpmmark[] bpmmarks;
double[] bpm;
double savedposition;
bool suc;
string saved;
double newpos;
file filer;
bool arrow;
double setting=100;
double distance;
string pack;
sound music;
double cpos;
#include "includes/enhanced_menu.nvgt"
string path;
message_history rd;
bool installed;
#include "includes/history.nvgt"
void help() {
if (lang==1) rd.say("press space to play/stop. Press control space to move the cursor to the new position when it is playing");
if (lang==2) rd.say("pulsa espacio para reproducir o parar. pulsa control espacio mientras se está reproduciendo para mover el cursor a esa posición.");
if (lang==1) rd.say("Press enter to copy the current position to the clipboard. Press A to automatically copy it when you move.");
if (lang==2) rd.say("pulsa enter para copiar la posición actual al portapapeles. Pulsa a para copiarla automáticamente cuando te muevas");
if (lang==1) rd.say("press right and left arrows to move through the file.");
if (lang==2) rd.say("pulsa las flechas izquierda y derecha para moverte por el archivo.");
if (lang==1) rd.say("use shift and the left or right arrow to scrub (move faster without letting go of the keys).");
if (lang==2) rd.say("pulsa shift con las flechas para moverte más rápido sin soltar las flechas.");
if (lang==1) rd.say("press numbers 1 through 0 to change time and bpm intervals that the arrows and page up and down keys move.");
if (lang==2) rd.say("para cambiar el intervalo de movimiento de las flechas o las teclas avanzar y retroceder página, pulsa los números del 1 al 0.");
if (lang==1) rd.say("press s to set the start of the song for the bpm marks, meaning that anything before that start will be ignored. To go to songstart, press shift s");
if (lang==2) rd.say("pulsa s para indicar que la posición actual es el inicio de la canción para las marcas del cronómetro (bpm). Lo anterior a esta marca no contará como parte de la canción. Para ir directo a la marca de inicio pulsa shift s.");
if (lang==1) rd.say("press b to set the bpm and put a mark in the current position");
if (lang==2) rd.say("pulsa la b para poner una marca de cronómetro en la posición actual.");
if (lang==1) rd.say("press page up and page down to move through the file in bpm intervals.");
if (lang==2) rd.say("pulsa página anterior y página siguiente para moverte por el archivo en intervalos del cronómetro.");
if (lang==1) rd.say("press home to go to the beginning of the file (ignoring songstart) and end to go to the end.");
if (lang==2) rd.say("pulsa la tecla inicio para ir al principio del archivo (sin tener en cuenta la marca de inicio) y fin para ir al final.");
if (lang==1) rd.say("press r and type the name of the level without extension to run it via the command line.");
if (lang==2) rd.say("Pulsa la r y escribe el nombre del nivel sin la extensión para ejecutarlo vía la línea de comandos.");
if (lang==1) rd.say("Press q to quit and save all data.");
if (lang==2) rd.say("pulsa la q para salir y guardar.");
}
void error(string l1,string l2,bool exiting=true) {
if (lang==1) alert("error",l1);
if (lang==2) alert("error",l2);
if (exiting) exit();
}
void main() {
if (!file_exists("z.iss")) path=SCRIPT_COMPILED?"mypacks":"../rg/mypacks";
if (file_exists("z.iss")) path=DIRECTORY_APPDATA+"/Oriol Gomez/rg/packs";
if (lang==1) show_game_window("level tool");
if (lang==2) show_game_window("herramienta del creador");
wait(500);
string[] folders=find_directories(path+"/*");
if (folders.length()<=0) {
if (lang==1) alert("error","no pack folders were detected in the mypacks folder.");
if (lang==2) alert("error","no se han detectado paquetes en la carpeta mypacks.");
exit();
}
//let the user choose which pack folder to work on
enhanced_menu packmenu;
packmenu.set_speech_mode(rd.reader_mode);
packmenu.ats("exit","salir","esc");
for (uint i=0;i<folders.length();i++) {
packmenu.ats(folders[i],folders[i],folders[i]);
}
string chosen;
if (lang==1) chosen=packmenu.run_extended("Choose which pack you want to work on. Use the arrow keys and press enter.",true,folders[0],true);
if (lang==2) chosen=packmenu.run_extended("Elige el paquete en el que quieres trabajar. Usa las flechas y pulsa enter.",true,folders[0],true);
if (chosen=="esc") exit();
pack=path+"/"+chosen+"/";
pm.set_callback(letters,"");
pm.set_speech_mode(rd.reader_mode);
files=find_files(pack+"*.ogg");

pm.ats("exit","salir","esc");
for (uint i=0;i<files.length();i++) {
pm.ats(files[i],files[i],files[i]);
}
string o;
string startitem="esc";
if (files.length()>0) startitem=files[0];
if (lang==1) o=pm.run_extended("you are in the folder "+pack+". select a file or press its first letter or number",true,startitem,true);
if (lang==2) o=pm.run_extended("estás en la carpeta "+pack+". selecciona un archivo, o pulsa la primera letra o número.",true,startitem,true);
if (o=="esc") {
exit();
}
else {
music.load(pack+o);
suc=filer.open(pack+o+".ltp","rb");
cpos=0;
if (suc) {
saved=filer.read();
string[] lines=string_split(saved,"\n",false);
savedposition=0;
for (uint i=0;i<lines.length();i++) {
string[] what=string_split(lines[i]," ",true);
if (what[0]=="position") {
savedposition=string_to_number(what[1]);
}
else if (what[0]=="bpm") {
string[] bd=string_split(what[1],",",true);
bpmmark b;
b.pos=string_to_number(bd[1]);
b.bpm=string_to_number(bd[0]);
for (uint i=0;i<bpmmarks.length();i++) {
if (bpmmarks[i].pos==string_to_number(bd[1])) {
bpmmarks.remove_at(i);
break;
}
}
bpmmarks.insert_last(b);
}
else if (what[0]=="start") {
songstart=string_to_number(what[1]);
}
else if (what[0]=="run") {
running=what[1];
running=string_replace(running,"\r","",true);
running=string_replace(running,"\n","",true);

}
}
}
if (savedposition!=0) {
rd.say("saved data restored");
cpos=savedposition;
}
suc=filer.open(pack+o+".ltp","wb");
if (!suc) error("can't open save file for writing","no se pudo abrir el archivo de posiciones para guardar.");
if (lang==1)
rd.say("loaded.");
if (lang==2)
rd.say("cargado");
if (lang==1)
rd.say("file is "+music.length+" milliseconds long;");
if (lang==2)
rd.say("el archivo dura "+music.length+" ms;");
if (lang==1)
rd.say("cursor at "+cpos+" ms.");
if (lang==2)
rd.say("cursor está en "+cpos+" ms.");
if (lang==1) rd.say("press h for keyboard shortcuts and q to quit the program and save.");
if (lang==2) rd.say("Pulsa la h para ayuda y la q para guardar y salir.");
}
while (true) {
if (key_pressed(KEY_A)) {
if (!acopy) {
acopy=true;
if (lang==2) rd.say("autocopiar posición activado");
if (lang==1) rd.say("auto copy position on.");
}
else if (acopy) {
acopy=false;
if (lang==2) rd.say("autocopiar posición desactivado.");
if (lang==1) rd.say("auto copy position off.");
}

}
if (key_pressed(KEY_R)) {
if (lang==1) running=input_box("run "+running,"Enter the name of the level you wish to run, without the .lvl extension:",running);
if (lang==2) running=input_box("ejecutar "+running,"Introduce el nombre del nivel a ejecutar, sin la extensión lvl:",running);
if (running!="") {
bool suc=false;
if (SCRIPT_COMPILED) suc=run("rg.exe",running+".lvl",false,false);
else suc=run(SCRIPT_EXECUTABLE,"rg.nvgt "+running+".lvl",false,false);
if (!suc) error("I couldn't run your level","No se pudo ejecutar el nivel.",false);
}
}
if (key_pressed(KEY_1)) {
setting=1;
setting2=1;
rd.say(setting+"ms, "+setting2+" beats.");
}
if (key_pressed(KEY_0)) {
setting=30000;
setting2=8;
rd.say(setting+"ms, "+setting2+" beats.");
}
if (key_pressed(KEY_2)) {
setting=5;
setting2=1/2.0;
rd.say(setting+"ms, "+setting2+" beats.");
}
if (key_pressed(KEY_3)) {
setting=10;
setting2=1/3.0;
rd.say(setting+"ms, "+setting2+" beats.");
}
if (key_pressed(KEY_4)) {
setting=25;
setting2=1/4.0;
rd.say(setting+"ms, "+setting2+" beats.");

}
if (key_pressed(KEY_5)) {
setting=50;
setting2=1/8.0;
rd.say(setting+"ms, "+setting2+" beats.");

}
if (key_pressed(KEY_6)) {
setting=100;
setting2=1/1.5;
rd.say(setting+"ms, "+setting2+" beats.");
}
if (key_pressed(KEY_7)) {
setting=500;
setting2=2;
rd.say(setting+"ms, "+setting2+" beats.");

}
if (key_pressed(KEY_8)) {
setting=1000;
setting2=3;
rd.say(setting+"ms, "+setting2+" beats.");

}
if (key_pressed(KEY_9)) {
setting=5000;
setting2=4;
rd.say(setting+"ms, "+setting2+" beats.");

}
if (music.position!=0) distance=absolute(music.position-cpos);
wait(5);
if (key_pressed(KEY_Q)) {
double ok=filer.write("position "+cpos+"\r\n");
if (songstart!=0) ok=filer.write("start "+songstart+"\r\n");
if (running!="") ok=filer.write("run "+running+"\r\n");
for (uint i=0;i<bpmmarks.length();i++) {
bpmmarks[i].save();
}
if (ok<1) {
error("can't save position","no se pudo guardar la posición.");
}
break;
}
if (music.position!=0) distance=absolute(music.position-cpos);
if (key_pressed(KEY_D)) rd.say(distance);
if(key_pressed(KEY_S))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) {
if (songstart!=0) {
rd.say("go to songstart.");
cpos=songstart;
music.seek(cpos);
}
else {
rd.say("songstart isn't set yet. Press s anywhere to set it.");
}
}
else {
songstart=cpos;
rd.say("Start set to "+songstart);
}
}
if(key_pressed(KEY_B))
{
if (cpos<songstart) {
rd.say("you cannot set a bpm mark before "+songstart+" because you set your songstart there. Press s anywhere to change it.");
}
else {
enhanced_menu bpc;
music.pause();
bpc.set_speech_mode(rd.reader_mode);
bpc.ats("manual","manual","m");
bpc.ats("tap tempo","tap tempo","t");
bpc.ats("cancel","cancelar","esc");
string ch=bpc.run_extended("How do you wish to enter the bpm for position "+cpos+"?",true,"esc",true);
if (ch=="esc") {
}
else if (ch=="t") {
rd.say("ok, I will now start playing the file from the current position and you will press the letter h in rhythm. When I have enough information, I will stop you and tell you the bpm.");
wait(1500);
timer tapping;
double[] taps;
while(true){
if (!music.playing) {
music.seek(cpos);
music.play();
}
if (key_pressed(KEY_H)) {
taps.insert_last(tapping.elapsed);
tapping.restart();
}
if (taps.length()>=10) {
taps.remove_at(0);
taps.remove_at(1);
double avg=0;
for (uint i=0;i<taps.length();i++) {
avg+=taps[i];
}
avg=round(avg/taps.length()-1,0);
music.stop();
rd.say("stop!");
wait(500);
avg=60000/avg;
rd.say("The bpm for this position is "+round(avg,0)+".");
bpmmark b;
b.pos=cpos;
b.bpm=avg;
for (uint i=0;i<bpmmarks.length();i++) {
if (bpmmarks[i].pos==cpos) {
bpmmarks.remove_at(i);
break;
}
}
bpmmarks.insert_last(b);
break;
}
}
}
else if (ch=="m") {
string ib=input_box("New BPM marker", "Type BPM value of marker to insert at current position.","");
bpmmark b;
b.pos=cpos;
b.bpm=string_to_number(ib);
for (uint i=0;i<bpmmarks.length();i++) {
if (bpmmarks[i].pos==cpos) {
bpmmarks.remove_at(i);
break;
}
}
bpmmarks.insert_last(b);
}
else if (ch=="t") {

}
}
}
if(key_pressed(KEY_Z) && !SCRIPT_COMPILED)
{
}
if (key_pressed(KEY_NEXT)) {
if (bpmmarks.length()==0) {
rd.say("no bpm marks found.");
}
else {
if (cpos<songstart) cpos=songstart;
upb();
double result=b2m(curbpm);
double newposi=cpos+(result*setting2);
if (newposi>music.length) newposi=music.length;
double result2=b2m(getbpm(newposi));
if (result==result2) {
cpos=newposi;
upb();
if (cpos>music.length) cpos=music.length;
music.seek(cpos);
}
else {
cpos=markpos;
music.seek(cpos);
upb();
}
}
if (acopy) clipboard_copy_text(round(cpos,0));
}
if (key_pressed(KEY_PRIOR)) {
if (bpmmarks.length()==0) {
rd.say("no bpm marks found.");
}
else {
if (cpos<songstart) cpos=songstart;
upb();
double result=b2m(curbpm);
double newposi=cpos-(result*setting2);
if (newposi<songstart) newposi=songstart;
double result2=b2m(getbpm(newposi));
if (result==result2) {
cpos=newposi;
upb();
if (cpos<0) {
rd.say("beginning.");
cpos=0;
}
music.seek(cpos);
}
else {
cpos=markpos;
music.seek(cpos);
upb();
}
}
if (acopy) clipboard_copy_text(round(cpos,0));
}
if (key_pressed(KEY_H)) help();
if (distance==0 and music.playing) {
}
if ((key_pressed(KEY_RIGHT)) or (key_down(KEY_RIGHT) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and mover.elapsed>=50)) {
mover.restart();
arrow=true;
cpos+=setting;
if (cpos>music.length) {
rd.say("end of file at "+music.length);
cpos=music.length;
}
newpos=cpos;
if (newpos>music.length) newpos=music.length;
music.seek(newpos);
if (music.position!=0) distance=absolute(music.position-cpos);
music.play();
if (acopy) clipboard_copy_text(round(cpos,0));
}
if ((key_pressed(KEY_LEFT)) or (key_down(KEY_LEFT) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and mover.elapsed>=50)) {
mover.restart();
arrow=true;
cpos-=setting;
if (cpos<0) {
rd.say("beginning.");
cpos=0;
}
newpos=cpos;
if (newpos<0) newpos=0;
music.seek(newpos);
cpos=music.position;
if (music.position!=0) distance=absolute(music.position-cpos);
music.play();
if (acopy) clipboard_copy_text(round(cpos,0));
}
if (music.position!=0) distance=absolute(music.position-cpos);
if (arrow and music.playing) {
if (distance>2000) {
arrow=false;
music.pause();
music.seek(cpos);
}
}
if (key_pressed(KEY_HOME)) {
rd.say("beginning");
cpos=0;
music.pause();
music.seek(cpos);
if (acopy) clipboard_copy_text(round(cpos,0));
}
if (key_pressed(KEY_END)) {
rd.say("end");
cpos=music.length;
music.pause();
music.seek(cpos);
if (acopy) clipboard_copy_text(round(cpos,0));
}
if (key_pressed(KEY_RETURN)) {
rd.say(round(cpos,0));
clipboard_copy_text(round(cpos,0));
}
if (key_pressed(KEY_SPACE)) {
arrow=false;
if (music.playing) {
if (key_down(KEY_LCONTROL)) {
cpos=music.position;
rd.say("cursor updated",true);
if (acopy) clipboard_copy_text(round(cpos,0));
}
music.pause();
music.seek(cpos);
}
else {
music.seek(cpos);
music.play();
}
}
if (music.position!=0) distance=absolute(music.position-cpos);
}
exit();
}
class bpmmark {
double bpm, pos;
void save() {
filer.write("bpm "+this.bpm+","+this.pos);
}
}
double getbpm(double pos) {
double newbpm=100000;
double dis=100000000;
double olddis=100000000;
double posmark;
for (uint i=0;i<bpmmarks.length();i++) {
dis=absolute(pos-bpmmarks[i].pos);
if (dis<olddis) {
newbpm=bpmmarks[i].bpm;
posmark=bpmmarks[i].pos;
}
olddis=dis;
}
if (dis!=100000000) {
markpos=posmark;
return newbpm;
}
else {
return -1;
}
}
double b2m(double v) {
return 60000/v;
}
void upb() {
curbpm=getbpm(cpos);
if (curbpm==-1) rd.say("bpm not found.");
}
string letters(enhanced_menu@ menu, string data) {
string chars=string_to_lower_case(get_characters());
if (chars.length()==1) {
for (uint i=0;i<files.length();i++) {
if (string_to_lower_case(string_left(files[i],1))==string_to_lower_case(string_left(chars,1))) {
rd.say(files[i]);
menu.menu_position_y=menu.get_item_index(files[i])[1];
return "";
}
}
return "";
}
return "";
}
