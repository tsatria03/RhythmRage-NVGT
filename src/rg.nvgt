string menu2(enhanced_menu@ lmenu, string data) {
if (key_repeating(KEY_NEXT)) { music.volume=music.volume-3; menuvol=music.volume; ser(); }
if (key_repeating(KEY_PRIOR)) { music.volume=music.volume+3; menuvol=music.volume; ser(); }
if (key_pressed(KEY_TAB)) {
if (lang==1) rd.say("You're playing "+pack+".pack");
if (lang==2) rd.say("Estás jugando "+pack+".pack");
}
return "";
}
string checkmenu(enhanced_menu@ lmenu, string data) {
if (key_repeating(KEY_NEXT)) { music.volume=music.volume-3; menuvol=music.volume; ser(); }
if (key_repeating(KEY_PRIOR)) { music.volume=music.volume+3; menuvol=music.volume; ser(); }
// Tab reports completion progress in a real pack. In a test/creator session every level is unlocked and nothing
// is saved, so there's no meaningful count - announce the pack name instead, like the main menu does.
if (key_pressed(KEY_TAB)) {
if (creatingpack) {
if (lang==1) rd.say("You're playing "+pack+".pack");
if (lang==2) rd.say("Estás jugando "+pack+".pack");
}
else {
// Once you've completed at least one level, append the whole-pack mastery percent; below that it's meaningless
// (and would read as 0), so just the completed/total count is announced.
if (levcompleted>=1) {
if (lang==1) rd.say(""+levcompleted+" of "+levtotal+" levels completed, "+levmastery+" percent.");
if (lang==2) rd.say(""+levcompleted+" de "+levtotal+" niveles completados, "+levmastery+" por ciento.");
}
else {
if (lang==1) rd.say(""+levcompleted+" of "+levtotal+" levels completed.");
if (lang==2) rd.say(""+levcompleted+" de "+levtotal+" niveles completados.");
}
}
}
if (creatingpack) return "";
string lev;
if (lmenu.currentItem()!=mp) {
mp=lmenu.currentItem();
if (mp!="esc") {
if (is_in_array(mp,lockedlevels)) {
if (lang==1) rd.say("locked");
if (lang==2) rd.say("bloqueado");
}
else {
lev=string_trim_right(mp,4);
int value=string_to_number(get_level(lev));
int pct=get_percent(lev);   // best score percentage, or -1 if none is recorded yet
sound@ statussound=null;
switch(value) {
case 0:
if (lang==1) rd.say("You haven't played this level before.");
if (lang==2) rd.say("No has jugado este nivel");
@statussound=newlevel;
break;
case 1:
// Failed, but you still played it, so announce the percentage (on its own line) then the failed status - it
// shows how close you got. Falls back to just the status for an old fail with no recorded percentage.
if (pct>=0) {
if (lang==1) rd.say(""+pct+" percent");
if (lang==2) rd.say(""+pct+" por ciento");
}
if (lang==1) rd.say("You played this level and failed.");
if (lang==2) rd.say("has fallado este nivel");
@statussound=faillevel;
break;
case 2:
// Passed: announce the best percentage on its own line (a separate, non-interrupting say so it queues as its
// own utterance) then the rating. Old scores without a recorded percentage fall back to just the rating.
if (pct>=0) {
if (lang==1) rd.say(""+pct+" percent");
if (lang==2) rd.say(""+pct+" por ciento");
}
if (lang==1) rd.say("ok");
if (lang==2) rd.say("bien");
@statussound=oklevel;
break;
case 3:
if (pct>=0) {
if (lang==1) rd.say(""+pct+" percent");
if (lang==2) rd.say(""+pct+" por ciento");
}
if (lang==1) rd.say("super");
if (lang==2) rd.say("súper");
@statussound=superlevel;
break;
case 4:
if (pct>=0) {
if (lang==1) rd.say(""+pct+" percent");
if (lang==2) rd.say(""+pct+" por ciento");
}
if (lang==1) rd.say("perfect!");
if (lang==2) rd.say("perfecto!");
@statussound=perfectlevel;
break;
}
// The spoken status above always plays; the jingle is held back only on the first focus after reopening on a
// remembered level, then plays normally for every later navigation.
if (@statussound!=null and !skipleveljingle) {
statussound.stop();
statussound.play();
}
}
}
skipleveljingle=false;
}
return "";
}
// All the language-dependent setup, in one place so it can be re-applied at runtime when the language changes.
void apply_language() {
if (lang==1) show_game_window("Rhythm Rage ");
if (lang==2) show_game_window("beatstar plus ");
sl="speaker_"+lang+"_";
vo.prepend=sl+"num_";
vo.include_and=(lang==2);
vo.append="";
set_sound_storage(path+"data/assets/sounds"+lang+".pack");
lockerror.load("lock_error");
oklevel.load("oklevel");
faillevel.load("faillevel");
newlevel.load("newlevel");
newlevel.volume=-2;
superlevel.load("superlevel");
perfectlevel.load("perfectlevel");
}
void main() {
string[] cml=string_split(com,"\\",true);
if (cml.length()>0) com=cml[cml.length()-1];
else com="";
@history_hook=@game_history_hook;   // route the shared reader's pause loop through the in-tutorial pause menu
// Clear any leftover pack-test builds from interrupted sessions.
string[] oldtests=find_files(DIRECTORY_TEMP+"/temptest*.pack");
for (uint i=0;i<oldtests.length();i++) file_delete(DIRECTORY_TEMP+"/"+oldtests[i]);
perfectjng="perfect_jingle";
super="super_jingle";
failjng="fail_jingle";
okjng="ok_jingle";
nopack();
installed=file_exists("z.iss");
if (installed) path=DIRECTORY_APPDATA+"/Oriol Gomez/";
directory_create(path);
if (installed) path=DIRECTORY_APPDATA+"/Oriol Gomez/rg/";
// Run from source: NVGT auto_chdir sets the working directory to this script's folder
// (src/), while the game's data lives in the sibling rg/ folder, so reach it via ../rg/.
if (!installed and !SCRIPT_COMPILED) path="../rg/";
// The portable data/ folder holds assets/ (engine sound packs) and saves/ (the profile). path resolves to the
// exe's folder when portable, ../rg/ from source, and the appdata rg/ folder when installed - so the folder can
// travel between computers with progress intact. Packs are kept separately in app data (see packdir below).
directory_create(path+"data");
directory_create(path+"data/assets");
directory_create(path+"data/saves");
// Packs are kept in a fixed app-data location rather than the portable data folder. The store and the
// downloader write here, so your packs persist independently of where the game folder sits.
packdir=DIRECTORY_APPDATA+"/Oriol Gomez/RhythmRage/packs/";
directory_create(DIRECTORY_APPDATA+"/Oriol Gomez");
directory_create(DIRECTORY_APPDATA+"/Oriol Gomez/RhythmRage");
directory_create(DIRECTORY_APPDATA+"/Oriol Gomez/RhythmRage/packs");
if (screen_reader_is_running(1)) install_keyhook();
generate_packs();
deser();          // load the saved profile (including the chosen language) before applying language-dependent setup
// Only one copy of the game may run at a time. gamstance grabbed the named mutex when it was
// constructed at startup; if another process already holds it, is_already_running is true.
// Checked after deser() so the message can use the player's saved language.
if (gamstance.is_already_running) {
if (lang==1) alert("Rhythm Rage","Rhythm Rage is already running.");
if (lang==2) alert("beatstar plus","beatstar plus ya se está ejecutando.");
exit();
return;
}
apply_language();
if (!SCRIPT_COMPILED && com=="") {
generate_soundpack();
}
if (com=="") playintro("logo"+lang,false);
// First run with an empty app-data packs folder: download (or, offline, compile) the default packs so there is
// something to open. Exits with an error if it can't get the default pack any way.
ensure_default_packs();
yespack();
package.open(cur_pack_file());
start();
}
