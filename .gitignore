.claude
New File*.txt

# Python bytecode cache
__pycache__/

# Compiled release builds
releases/

# Intermediate compile output: the bundle nvgt -c produces in src/ before tools.py moves it into releases/
src/rg/
src/rg.app/

# Binary engine libraries (DLLs + bundled tools.
rg/lib/

# Binary media assets
rg/mypacks/
rg/data/assets/

# Local player save (the dev's own profile, written here when testing from source) - never commit or ship
rg/data/saves/rg.dat

# Generated pack-downloader index (built by tools.py from the app-data packs, uploaded to the VPS root) - not source
rg/pack_index.txt
